---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title = "Depot Heights | Bukit Merah, Singapore",
  description = "Discover Depot Heights in Bukit Merah, Singapore — a neighbourhood guide covering local food, cafés, restaurants, shopping, healthcare, schools, transport, parks and everyday living.",
  canonical,
  image = "/images/depot-heights-hero.webp",
  imageAlt = "Depot Heights in Bukit Merah, Singapore",
  noindex = false,
} = Astro.props;

const siteUrl = "https://depot-heights.pages.dev";

const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();

const imageUrl = new URL(image, siteUrl).toString();

const navItems = [
  {
    label: "Home",
    href: "/",
  },
  {
    label: "About",
    href: "/about-depot-heights",
  },
  {
    label: "Lifestyle",
    href: "/lifestyle",
  },
  {
    label: "Location",
    href: "/location",
  },
];

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="generator"
      content={Astro.generator}
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    {noindex && (
      <meta
        name="robots"
        content="noindex, nofollow"
      />
    )}

    <!-- Favicon -->

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <!-- Open Graph -->

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:image"
      content={imageUrl}
    />

    <meta
      property="og:image:alt"
      content={imageAlt}
    />

    <meta
      property="og:site_name"
      content="Depot Heights"
    />

    <!-- Twitter / Social Sharing -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={imageUrl}
    />

    <meta
      name="twitter:image:alt"
      content={imageAlt}
    />
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a
          class="brand"
          href="/"
          aria-label="Depot Heights home"
        >
          <span class="brand-mark">
            DH
          </span>

          <span class="brand-text">
            <strong>DEPOT HEIGHTS</strong>

            <small>
              Living, Dining, Nature & Convenience
            </small>
          </span>
        </a>

        <nav
          class="main-nav"
          aria-label="Main navigation"
        >
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={{
                  active:
                    item.href === "/"
                      ? currentPath === "/"
                      : currentPath.startsWith(item.href),
                }}
                aria-current={
                  item.href === "/"
                    ? currentPath === "/"
                      ? "page"
                      : undefined
                    : currentPath.startsWith(item.href)
                      ? "page"
                      : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>DEPOT HEIGHTS</strong>

          <p>
            Living, Dining, Nature & Convenience
          </p>
        </div>

        <div class="footer-links">
          {
            navItems.map((item) => (
              <a href={item.href}>
                {item.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="footer-bottom">
        <p>
          © {new Date().getFullYear()} Depot Heights.
          All rights reserved.
        </p>

        <p>
          Bukit Merah, Singapore
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    background: #f7f8f3;
    color: #183126;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: rgba(255, 255, 252, 0.96);
    border-bottom: 1px solid rgba(24, 49, 38, 0.08);
    backdrop-filter: blur(12px);
  }

  .header-inner {
    width: min(1400px, 90vw);
    min-height: 78px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #2b6e52;
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .brand-text strong {
    display: block;
    color: #183126;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.2;
  }

  .brand-text small {
    display: block;
    margin-top: 3px;
    color: #718078;
    font-size: 11px;
    line-height: 1.3;
  }

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 28px;
    font-size: 18px;
    font-weight: 700;
  }

  .main-nav a {
    position: relative;
    padding: 8px 0;
    color: #5d6b64;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .main-nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: #2b6e52;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.2s ease;
  }

  .main-nav a:hover {
    color: #2b6e52;
  }

  .main-nav a:hover::after,
  .main-nav a.active {
    color: #2b6e52;
  }

  .main-nav a.active::after {
    transform: scaleX(1);
  }

  .site-footer {
    padding: 55px 5vw 25px;
    background: #0d2119;
    color: #d8e9df;
  }

  .footer-inner {
    width: min(1400px, 90vw);
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  .footer-brand strong {
    display: block;
    color: #ffffff;
    font-size: 14px;
    letter-spacing: 0.08em;
  }

  .footer-brand p {
    margin: 5px 0 0;
    color: #a9c1b5;
    font-size: 13px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px 28px;
    font-size: 14px;
    font-weight: 600;
  }

  .footer-links a {
    color: #d8e9df;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    width: min(1400px, 90vw);
    margin: 40px auto 0;
    padding-top: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid rgba(216, 233, 223, 0.15);
  }

  .footer-bottom p {
    margin: 0;
    color: #8fa99c;
    font-size: 12px;
  }

  @media (max-width: 900px) {
    .header-inner {
      min-height: 72px;
      gap: 25px;
    }

    .main-nav {
      gap: 20px;
      font-size: 16px;
    }
  }

  @media (max-width: 700px) {
    .site-header {
      position: relative;
    }

    .header-inner {
      width: 90vw;
      padding: 16px 0;
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .main-nav {
      width: 100%;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 8px 18px;
      font-size: 16px;
    }

    .footer-inner {
      width: 90vw;
      flex-direction: column;
      gap: 25px;
    }

    .footer-links {
      justify-content: flex-start;
    }

    .footer-bottom {
      width: 90vw;
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }
  }

  @media (max-width: 420px) {
    .brand-text small {
      font-size: 10px;
    }

    .main-nav {
      gap: 6px 15px;
      font-size: 15px;
    }
  }
</style>