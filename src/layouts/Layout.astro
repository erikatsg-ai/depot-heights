---
import '../styles/global.css';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: string;
}

const {  
  title,  
  description,  
  canonical = Astro.url.href,
  image = "/images/depot-heights-hero.webp",
  type = "website" 
} = Astro.props;

// Hardcoded fallback base URL to guarantee valid links even if Astro.site is unconfigured
const baseSiteUrl = "https://pages.dev";
const siteUrl = Astro.site ? Astro.site.origin : baseSiteUrl;

// Resolve absolute URLs for metadata engines
const resolvedImage = new URL(image, siteUrl).href;
const cleanCanonical = new URL(canonical, baseSiteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Core Technical Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    
    
    <link rel="canonical" href={cleanCanonical} />
    
    <!-- Modern & Legacy Favicons -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${import.meta.env.BASE_URL}favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${import.meta.env.BASE_URL}favicon-16x16.png`} />
    <link rel="shortcut icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />

    <!-- Apple Devices/iOS Smart Bar -->
    <link rel="apple-touch-icon" sizes="180x180" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    
    <!-- Open Graph Protocol (Facebook, WhatsApp) -->
    <meta property="og:site_name" content="Depot Heights HDB Estate Guide" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:image:alt" content="Depot Heights Neighbourhood Layout Visual" />

    <!-- Twitter/X Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
  </head>
  <body>
    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
