---
import Layout from "../layouts/Layout.astro";
import ImageGallery from "../components/ImageGallery.astro";

const pageTitle =
  "Best Cafés Near Depot Heights | Alexandra, Bukit Merah & Tiong Bahru Coffee Guide";

const pageDescription =
  "Explore recommended cafés near Depot Heights, including coffee spots around Alexandra, Anchorpoint, Tiong Bahru, Telok Blangah and Tanjong Pagar.";

const canonicalUrl = "https://depot-heights.pages.dev/cafes";

const heroImage = "/images/depot-heights-hero.webp";

const cafeEstates = [
  {
    estate: "Mount Faber Park",
    cafes: [
      {
        number: "01",
        id: "dusk",
        name: "DUSK",
        location: "Mount Faber Park",
        image: "/images/dusk.webp",
        alt: "DUSK at Mount Faber near Depot Heights",
        description:
          "DUSK is a scenic dining destination on Mount Faber, offering residents a relaxing setting surrounded by greenery. Its location makes it a good choice when you want to combine a meal or drinks with the atmosphere of Mount Faber and the surrounding Southern Ridges.",
        highlight:
          "A scenic destination for a relaxed outing surrounded by greenery on Mount Faber.",
      },
      {
        number: "02",
        id: "arbora-cafe",
        name: "Arbora Café",
        location: "Mount Faber Park",
        image: "/images/cafe-arbora-mount-faber.webp",
        alt: "Arbora Café at Mount Faber near Depot Heights",
        description:
          "Arbora Café is a relaxed café and dining destination on Mount Faber. Surrounded by greenery, it offers a change of scenery from the everyday neighbourhood routine and can be combined with a visit to Mount Faber Park and the surrounding walking routes.",
        highlight:
          "A peaceful café destination that pairs naturally with a Mount Faber and Southern Ridges outing.",
      },
      {
        number: "03",
        id: "wildseed-alkaff-mansion",
        name: "Wildseed Café at The Alkaff Mansion",
        location: "Telok Blangah Hill Park",
        image: "/images/cafe-wildseed-alkaff-mansion.webp",
        alt: "Wildseed Café at The Alkaff Mansion",
        description:
          "Set inside a magnificent 1920s heritage bungalow on Telok Blangah Hill, Wildseed Café provides a pet-friendly sanctuary offering hearty brunch fare, botanical drinks, and historic charm.",
        highlight:
          "A majestic heritage mansion cafe nestled high amidst the greenery of Telok Blangah Hill.",
      },
    ],
  },
  {
    estate: "Tiong Bahru & Alexandra",
    cafes: [
      {
        number: "04",
        id: "tionghoe-specialty-coffee",
        name: "Tionghoe Specialty Coffee",
        location: "Tiong Bahru",
        image: "/images/cafe-tionghoe-specialty-coffee.webp",
        alt: "Tionghoe Specialty Coffee at Tiong Bahru",
        description:
          "Tionghoe Specialty Coffee is a hidden gem micro-roastery and café serving meticulously brewed specialty coffees in a cozy, minimalist setting right within the heart of Tiong Bahru.",
        highlight:
          "An artisanal local roastery and coffee spot dedicated to precision brews in a heritage estate.",
      },
      {
        number: "05",
        id: "micro-bakery-kitchen",
        name: "MICRO Bakery Kitchen",
        location: "Tiong Bahru",
        images: [
          {
            src: "/images/cafe-micro-bakery-kitchen(0).webp",
            alt: "MICRO Bakery Kitchen exterior and interior space in Tiong Bahru",
          },
          {
            src: "/images/cafe-micro-bakery-kitchen(1).webp",
            alt: "Artisan sourdough and bakes at MICRO Bakery Kitchen",
          },
        ],
        description:
          "MICRO Bakery Kitchen at Tiong Bahru focuses on organic sourdough breads, artisanal bakes, and comforting brunch items served in a cozy, laid-back neighborhood setting.",
        highlight:
          "A charming spot for artisan sourdough bakes and relaxed brunch dining in heritage Tiong Bahru.",
      },
      {
        number: "06",
        id: "tiong-bahru-bakery",
        name: "Tiong Bahru Bakery",
        location: "Eng Hoon Street, Tiong Bahru",
        image: "/images/cafe-tiong-bahru-bakery.webp",
        alt: "Tiong Bahru Bakery on Eng Hoon Street",
        description:
          "The flagship Tiong Bahru Bakery on Eng Hoon Street is renowned for its exceptional French pastries, particularly its signature flaky croissants, paired with quality coffee in a vibrant heritage enclave.",
        highlight:
          "A legendary neighborhood institution famous for world-class croissants and artisanal pastries.",
      },
      {
        number: "07",
        id: "xin-wang-hong-kong-cafe",
        name: "Xin Wang Hong Kong Café",
        location: "Anchorpoint",
        image: "/images/cafe-xinwang.webp",
        alt: "Xin Wang Hong Kong Café at Anchorpoint",
        description:
          "Xin Wang Hong Kong Café at Anchorpoint serves a wide variety of casual Hong Kong comfort food, beverages, and classic bakery treats in an accessible, family-friendly setting close to Depot Heights.",
        highlight:
          "A popular casual spot for comfort food, classic Hong Kong cafe fare, and drinks at Anchorpoint.",
      },
      {
        number: "08",
        id: "starbucks-anchorpoint",
        name: "Starbucks",
        location: "Anchorpoint",
        image: "/images/cafe-starbucks.webp",
        alt: "Starbucks at Anchorpoint",
        description:
          "Starbucks at Anchorpoint offers a comfortable neighborhood space to enjoy signature coffees, teas, and seasonal treats, making it a convenient stop for catching up or remote work.",
        highlight:
          "A familiar and cozy spot for your favorite coffee brews right within Anchorpoint.",
      },
      {
        number: "09",
        id: "toastbox-alexandra-central",
        name: "Toast Box",
        location: "Alexandra Central",
        image: "/images/cafe-toastbox.webp",
        alt: "Toast Box at Alexandra Central",
        description:
          "Toast Box at Alexandra Central offers traditional local coffee, soft-boiled eggs, and freshly toasted kaya bread in a nostalgic kopitiam-inspired setting.",
        highlight:
          "A classic local kopitiam experience ideal for traditional breakfast and afternoon tea breaks.",
      },
      {
        number: "10",
        id: "ahseng-durian",
        name: "Ah Seng Durian",
        location: "Alexandra Village",
        image: "/images/cafe-ahseng-durian.webp",
        alt: "Ah Seng Durian at Alexandra Village",
        description:
          "Ah Seng Durian at Alexandra Village is a renowned local institution famous for premium quality durians and inventive durian-infused treats, drawing fans from across the island.",
        highlight:
          "A must-visit destination for top-grade durians and specialty local fruit treats in Alexandra Village.",
      },
      {
        number: "11",
        id: "yakun-margaret",
        name: "Ya Kun Kaya Toast",
        location: "Margaret Market",
        image: "/images/cafe-yakun.webp",
        alt: "Ya Kun Kaya Toast at Margaret Market",
        description:
          "Ya Kun Kaya Toast at Margaret Market serves up its legendary fragrant Nanyang coffee, crispy kaya butter toast, and traditional eggs within a vibrant community lifestyle hub.",
        highlight:
          "An iconic local heritage breakfast spot nestled inside the neighborhood Margaret Market.",
      },
    ],
  },
  {
    estate: "Gillman Barracks & Pasir Panjang",
    cafes: [
      {
        number: "12",
        id: "canopy-hortpark",
        name: "Canopy",
        location: "HortPark",
        image: "/images/cafe-canopy-hortpark.webp",
        alt: "Canopy at HortPark",
        description:
          "Canopy at HortPark is a tranquil nature-centric café set directly amidst lush greenery and park connectors, perfect for a relaxing meal after exploring the Southern Ridges.",
        highlight:
          "An idyllic parkside dining destination immersed completely in nature along the Southern Ridges.",
      },
      {
        number: "13",
        id: "knots-cafe-living",
        name: "Knots Cafe & Living",
        location: "Pasir Panjang",
        image: "/images/cafe-knots-pasir-Panjang.webp",
        alt: "Knots Cafe & Living at Pasir Panjang",
        description:
          "Knots Cafe & Living is a unique rustic concept combining a cozy café, plant nursery, and furniture store, offering hearty comfort food amidst lush floral and wooden aesthetics.",
        highlight:
          "A delightful multi-concept dining space surrounded by plants, flowers, and rustic furniture.",
      },
    ],
  },
  {
    estate: "Dempsey Hill",
    cafes: [
      {
        number: "14",
        id: "ps-cafe-dempsey",
        name: "PS.Cafe",
        location: "Dempsey Hill",
        images: [
          {
            src: "/images/cafe-ps-cafe-dempsey(1).webp",
            alt: "PS.Cafe Dempsey lush interior setup",
          },
          {
            src: "/images/cafe-ps-cafe-dempsey(2).webp",
            alt: "Dining tables at PS.Cafe Dempsey Hill",
          },
          {
            src: "/images/cafe-ps-cafe-dempsey(3).webp",
            alt: "Signature cafe dishes at PS.Cafe Dempsey",
          },
          {
            src: "/images/cafe-ps-cafe-dempsey(4).webp",
            alt: "Greenery view surrounding PS.Cafe Dempsey",
          },
        ],
        description:
          "PS.Cafe at Dempsey Hill offers an iconic lush garden dining experience, famous for its grand interiors, generous comfort food portions, and legendary truffle shoestring fries.",
        highlight:
          "A luxurious garden sanctuary known for lush green surroundings and signature cafe comforts.",
      },
    ],
  },
  {
    estate: "Botanic Gardens & Fort Canning",
    cafes: [
      {
        number: "15",
        id: "wildseed-botanic-gardens",
        name: "Wildseed Café at The Garage",
        location: "Singapore Botanic Gardens",
        image: "/images/cafe-wildseed-garage.webp",
        alt: "Wildseed Café at The Garage Botanic Gardens",
        description:
          "Nestled within a historic art deco garage inside the Singapore Botanic Gardens, Wildseed Café serves floral-inspired cakes, brunch items, and coffee surrounded by UNESCO heritage greenery.",
        highlight:
          "A gorgeous floral café experience housed within a heritage building at the Botanic Gardens.",
      },
      {
        number: "16",
        id: "le-jardin-cafe",
        name: "Le Jardin Cafe",
        location: "Fort Canning Park",
        image: "/images/cafe-le-jardin-fort-canning.webp",
        alt: "Le Jardin Cafe at Fort Canning Park",
        description:
          "Le Jardin Cafe is a European-inspired floral café located at Fort Canning Park, offering pet-friendly dining, gorgeous vintage aesthetics, and brunch dishes framed by lush park views.",
        highlight:
          "A whimsical, French-and-Victorian-inspired garden cafe hidden within historic Fort Canning.",
      },
    ],
  },
];

const cafeAreas = [
  {
    title: "Mount Faber & Southern Ridges",
    description:
      "Mount Faber is one of the most scenic café and dining areas near Depot Heights. Residents can combine a café visit with walks through Mount Faber Park, the Southern Ridges and nearby Henderson Waves.",
  },
  {
    title: "Gillman Barracks",
    description:
      "Gillman Barracks offers a distinctive combination of art, heritage, food and leisure. It is a good destination for a longer afternoon or evening outing, with galleries and dining options located within the former military compound.",
  },
  {
    title: "Tiong Bahru & Alexandra",
    description:
      "The nearby Tiong Bahru heritage enclave and Alexandra area provide residents with exceptional artisan bakeries, trendy cafes, and rich local cafe culture options.",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  image={heroImage}
>
  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">
          CAFÉS & CASUAL DINING NEAR DEPOT HEIGHTS
        </p>

        <h1>
          Coffee,
          <span>greenery & good company.</span>
        </h1>

        <p class="hero-text">
          Depot Heights residents have a range of cafés and casual
          dining destinations to explore across Mount Faber Park, the
          Southern Ridges, HortPark, Tiong Bahru, and Dempsey. 
          Whether you are looking for a scenic outing, a relaxed meal 
          or somewhere to meet friends, there are places worth discovering nearby.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#cafe-guide">
            Explore cafés
          </a>

          <a class="button secondary" href="/local-food">
            Explore local food
          </a>
        </div>
      </div>

      <div class="hero-card">
        <img
          src="/images/dusk.webp"
          alt="DUSK at Mount Faber near Depot Heights"
          width="600"
          height="400"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <div class="hero-card-overlay">
          <p>DEPOT HEIGHTS</p>

          <div class="hero-card-line"></div>

          <strong>
            Coffee stops.<br />
            Scenic surroundings.
          </strong>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro">
      <p class="eyebrow">
        CAFÉ LIFE AROUND THE NEIGHBOURHOOD
      </p>

      <h2>
        A coffee break is never far away.
      </h2>

      <p>
        From the greenery of Mount Faber Park and HortPark to the vibrant atmosphere
        of Alexandra, Anchorpoint, and historic Tiong Bahru streets, Depot Heights is surrounded 
        by cafés and casual dining destinations worth exploring. These places are
        especially enjoyable when combined with nearby parks, walking
        routes, galleries and other neighbourhood attractions.
      </p>
    </section>

    <!-- CAFE GUIDE BY ESTATE -->
    <div class="section-grid" id="cafe-guide">
      {
        cafeEstates.map((group) => (
          <div class="estate-group">
            <div class="estate-heading-wrapper">
              <span class="estate-badge">NEIGHBOURHOOD ZONE</span>
              <h2>{group.estate}</h2>
            </div>

            <div class="estate-cafes-container">
              {group.cafes.map((cafe) => (
                <article class="section-card" id={cafe.id}>
                  <div class="section-number">
                    {cafe.number}
                  </div>

                  <div>
                    <p class="eyebrow">
                      {cafe.location}
                    </p>

                    <h2>
                      {cafe.name}
                    </h2>

                    <p class="section-description">
                      {cafe.description}
                    </p>

                    {
                      cafe.images ? (
                        <div class={`cafe-photo-grid ${cafe.images.length === 4 ? 'four-photos' : 'two-photos'}`}>
                          {cafe.images.map((photo) => (
                            <figure class="cafe-photo-card">
                              <img
                                src={photo.src}
                                alt={photo.alt}
                                width="400"
                                height="300"
                                loading="lazy"
                                decoding="async"
                              />
                            </figure>
                          ))}
                        </div>
                      ) : (
                        <div class="main-cafe-image">
                          <img
                            src={cafe.image}
                            alt={cafe.alt}
                            width="800"
                            height="480"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      )
                    }

                    <div class="highlight-box">
                      <p class="highlight-eyebrow">
                        WHY VISIT
                      </p>

                      <p>
                        {cafe.highlight}
                      </p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- AREAS TO EXPLORE -->
    <section class="area-section">
      <div class="area-heading">
        <p class="eyebrow">
          CAFÉ AREAS TO EXPLORE
        </p>

        <h2>
          Different neighbourhoods, different experiences.
        </h2>

        <p>
          The café and casual dining scene around Depot Heights
          extends beyond individual destinations. Several nearby
          areas offer their own combination of scenery, food,
          heritage, arts and leisure activities.
        </p>
      </div>

      <div class="area-grid">
        {
          cafeAreas.map((area) => (
            <article class="area-card">
              <h3>
                {area.title}
              </h3>

              <p>
                {area.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- FEATURED -->
    <section class="featured">
      <div>
        <p class="eyebrow">
          LOCAL CAFÉ GUIDE
        </p>

        <h2>
          Good coffee and good food can be part of the neighbourhood routine.
        </h2>
      </div>

      <p>
        Living at Depot Heights means having access to both everyday
        neighbourhood food options and destination dining surrounded
        by greenery, heritage and arts. Start with Mount Faber Park and HortPark, 
        then explore the wider Alexandra, Anchorpoint, and Bukit Merah neighbourhoods.
      </p>
    </section>

    <!-- RELATED -->
    <section class="related-section">
      <div class="related-heading">
        <p class="eyebrow">
          MORE FOOD & DINING
        </p>

        <h2>
          Continue exploring the neighbourhood.
        </h2>
      </div>

      <div class="related-grid">
        <article class="related-card">
          <h3>
            Local Food
          </h3>

          <p>
            Explore hawker centres, markets and local food destinations
            around Depot Heights, Bukit Merah, Alexandra and nearby
            neighbourhoods.
          </p>

          <a class="text-link" href="/local-food">
            Explore Local Food →
          </a>
        </article>

        <article class="related-card">
          <h3>
            Restaurants
          </h3>

          <p>
            Discover restaurants and dining destinations around
            Depot Heights, Mount Faber, Alexandra and the wider
            neighbourhood.
          </p>

          <a class="text-link" href="/restaurants">
            Explore Restaurants →
          </a>
        </article>

        <article class="related-card">
          <h3>
            Lifestyle & Nature
          </h3>

          <p>
            Explore parks, heritage sites, arts, shopping and leisure
            destinations around Depot Heights and the surrounding
            neighbourhoods.
          </p>

          <a class="text-link" href="/living-around-depot-heights">
            Explore Lifestyle & Nature →
          </a>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    color: #1d2924;
    background: #f7f5ef;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    display: grid;
    grid-template-columns:
      minmax(0, 1.5fr)
      minmax(280px, 0.7fr);
    min-height: 78vh;
    padding: 8rem 8vw 6rem;
    gap: 5rem;
    align-items: center;
    background:
      radial-gradient(
        circle at 80% 30%,
        rgba(94, 145, 112, 0.22),
        transparent 35%
      ),
      linear-gradient(
        135deg,
        #eef3e9 0%,
        #f7f5ef 60%
      );
  }

  .hero-content {
    max-width: 850px;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #3d805f;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size:
      clamp(45px, 8vw, 80px);
    line-height: 0.94;
    letter-spacing: -0.07em;
  }

  h1 span {
    display: block;
    color: #3d805f;
  }

  .hero-text {
    max-width: 700px;
    margin: 1.8rem 0 0;
    color: #53615b;
    font-size: 17px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    padding: 0.9rem 1.25rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 750;
  }

  .primary {
    color: white;
    background: #27664d;
  }

  .secondary {
    color: #27664d;
    border: 1px solid #9eb3a5;
  }

  .hero-card {
    position: relative;
    min-height: 360px;
    overflow: hidden;
    border-radius: 2rem;
    color: white;
    background: #315f4a;
    box-shadow:
      0 25px 70px
      rgba(39, 102, 77, 0.18);
  }

  .hero-card img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
  }

  .hero-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(31, 72, 55, 0.05),
        rgba(31, 72, 55, 0.9)
      );
  }

  .hero-card-overlay {
    position: absolute;
    z-index: 2;
    right: 2rem;
    bottom: 2rem;
    left: 2rem;
  }

  .hero-card-overlay p {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .hero-card-line {
    width: 50px;
    height: 2px;
    margin: 1rem 0;
    background: white;
  }

  .hero-card strong {
    display: block;
    font-size:
      clamp(1.8rem, 3vw, 3rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 850px;
    margin: 0 auto;
    padding: 8rem 8vw 4rem;
    text-align: center;
  }

  .intro h2,
  .featured h2,
  .related-heading h2,
  .area-heading h2 {
    margin: 0;
    font-size:
      clamp(38px, 5vw, 65px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .intro > p:last-child {
    margin: 1.5rem auto 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.7;
  }

  .section-grid {
    padding: 2rem 8vw 8rem;
    max-width: 1300px;
    margin: 0 auto;
  }

  .estate-group {
    margin-bottom: 5rem;
  }

  .estate-group:last-child {
    margin-bottom: 0;
  }

  .estate-heading-wrapper {
    max-width: 1100px;
    margin: 0 auto 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #27664d;
  }

  .estate-badge {
    display: inline-block;
    color: #27664d;
    background: rgba(39, 102, 77, 0.1);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
  }

  .estate-heading-wrapper h2 {
    margin: 0;
    font-size: clamp(28px, 3.5vw, 48px);
    letter-spacing: -0.04em;
    color: #1d2924;
  }

  .section-card {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 0;
    border-top:
      1px solid
      rgba(29, 41, 36, 0.15);
  }

  .estate-cafes-container .section-card:first-of-type {
    border-top: none;
    padding-top: 1rem;
  }

  .section-number {
    color: #70a281;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .section-card h2 {
    margin: 0;
    font-size:
      clamp(38px, 4vw, 65px);
    letter-spacing: -0.05em;
  }

  .section-description {
    max-width: 700px;
    margin: 1.2rem 0 2rem;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .main-cafe-image {
    margin: 2rem 0;
  }

  .main-cafe-image img {
    display: block;
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 2rem;
    box-shadow:
      0 20px 50px
      rgba(39, 102, 77, 0.12);
  }

  .cafe-photo-grid {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
  }

  .cafe-photo-grid.two-photos {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .cafe-photo-grid.four-photos {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .cafe-photo-card {
    margin: 0;
    overflow: hidden;
    border-radius: 1.5rem;
