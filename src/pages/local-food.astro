---
import Layout from "../layouts/Layout.astro";

const featuredFoodCentres = [
  {
    id: "alexandra-village",
    number: "01",
    title: "Alexandra Village Food Centre",
    location: "Bukit Merah / Alexandra Road",
    image: "/images/alexandra-village-fc.webp",
    description:
      "Alexandra Village Food Centre is one of the most convenient local hawker destinations for Depot Heights residents. The wider Alexandra and Bukit Merah Lane 1 area also has several established local food businesses and traditional food specialists worth exploring.",
    gettingThere:
      "A convenient local food destination from Depot Heights, with the surrounding Bukit Merah Lane 1 area offering additional food stops for residents who want to explore beyond the main food centre.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Alexandra+Village+Food+Centre+Singapore",
  },
  {
    id: "abc-brickworks",
    number: "02",
    title: "ABC Brickworks Market & Food Centre",
    location: "Jalan Bukit Merah",
    image: "/images/abc-brickworks-market.webp",
    description:
      "For Depot Heights residents, ABC Brickworks Food Centre offers a welcome change of pace from the usual Depot Road haunts. Located next to Alexandra Central, this iconic food centre has been a local favourite for decades, dishing out classic hawker favourites with Muslim Halal choices, that keep diners coming back for more.",
    gettingThere:
      "Located along Jalan Bukit Merah, ABC Brickworks is a convenient addition to a wider local food outing around Bukit Merah and Alexandra.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=ABC+Brickworks+Market+Food+Centre+Singapore",
  },
  {
    id: "margaret-drive",
    number: "03",
    title: "Margaret Drive Hawker Centre",
    location: "Margaret Drive",
    image: "/images/margaret-dr-hawker-centre.webp",
    description:
      "For those alighting at Queenstown MRT, Margaret Drive Hawker Centre is a convenient and worthwhile food stop just a short walk away. This sleek two-storey centre, offers a compact but impressive lineup of 38 stalls. Muslim diners are well-catered for with halal-certified options like Queenstown Lontong and Sukarnih Chicken Rice. Meanwhile, the ever-popular Hakka Thunder Tea Rice stall (#02-34) draws long queues for its wholesome lei cha, served with white or brown rice, fresh chopped vegetables, crunchy peanuts and ikan bilis, plus a fragrant herbal soup. Beyond the hawker stalls, the area also offers air-conditioned indoor dining choices, including pizza outlets and Yakun Kaya Toast, perfect for those seeking a cooler, more contemporary meal setting",
    gettingThere:
      "Located in the Margaret Drive neighbourhood, this is a useful food stop when exploring the wider Queenstown area from Depot Heights.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Margaret+Drive+Hawker+Centre+Singapore",
  },
  {
    id: "tiong-bahru",
    number: "04",
    title: "Tiong Bahru Food Centre",
    location: "Tiong Bahru",
    image: "/images/tiong-bahru-market.webp",
    description:
      "One of the best-known hawker centres near Depot Heights, Tiong Bahru Food Centre is a favourite for exploring traditional Singaporean hawker food. The surrounding Tiong Bahru neighbourhood also offers a mix of heritage streets, cafés, restaurants and independent shops.",
    gettingThere:
      "Take Bus 175 (faster) or Bus 195, and alight at Bus Stop Blk 1 (10149) or Blk 55 (06051), Tiong Bahru Road, then walk behind the block to reach the food centre. Approximately 3.2 km from Depot Heights.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Tiong+Bahru+Food+Centre+Singapore",
  },
  {
    id: "bukit-merah-view",
    number: "05",
    title: "Bukit Merah View Market & Hawker Centre",
    location: "Bukit Merah View",
    image: "/images/bukit-merah-view-market-food-centre.webp",
    description:
      "A neighbourhood market and hawker centre serving the Bukit Merah View community. It is one of the local food destinations around Depot Heights that residents can visit when exploring the wider Bukit Merah neighbourhood.",
    gettingThere:
      "A convenient option for exploring the local food scene around Bukit Merah View and the surrounding residential estates.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Bukit+Merah+View+Market+Hawker+Centre+Singapore",
  },
];

const otherFoodCentres = [
  {
    id: "bukit-merah-central",
    number: "06",
    title: "Bukit Merah Central Food Centre",
    location: "Bukit Merah Central",
    image: "/images/bukit-merah-central-food-centre.webp",
    description:
      "Located within the established Bukit Merah Central neighbourhood, this food centre is surrounded by residential blocks and everyday amenities. It is a convenient option when visiting the Bukit Merah town centre.",
    gettingThere:
      "A useful local food stop when visiting Bukit Merah Central and the surrounding neighbourhood amenities.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Bukit+Merah+Central+Food+Centre+Singapore",
  },
  {
    id: "mei-ling",
    number: "07",
    title: "Mei Ling Market & Food Centre",
    location: "Mei Chin Road",
    image: "/images/mei-ling-market-food-centre.webp",
    description:
      "A neighbourhood market and food centre serving the Mei Ling estate and surrounding Queenstown community. It is a quieter local destination for residents who enjoy exploring traditional markets and neighbourhood food centres.",
    gettingThere:
      "A local food destination in the Queenstown area and a useful addition to a wider food trip around the surrounding neighbourhoods.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Mei+Ling+Market+Food+Centre+Singapore",
  },
  {
    id: "redhill-food-centre",
    number: "08",
    title: "Redhill Food Centre",
    location: "Redhill",
    image: "/images/redhill-food-centre.webp",
    description:
      "A neighbourhood food destination in the Redhill area, offering another selection of local hawker food. It is a useful stop for residents who want to explore beyond the immediate Depot Road and Bukit Merah area.",
    gettingThere:
      "A good destination to include when exploring the wider Redhill neighbourhood and its surrounding local amenities.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Redhill+Food+Centre+Singapore",
  },
  {
    id: "seah-im",
    number: "09",
    title: "Seah Im Food Centre",
    location: "Seah Im Road / HarbourFront",
    image: "/images/seah-im-food-centre.webp",
    description:
      "Located near HarbourFront, Seah Im Food Centre is a convenient local food stop when visiting the HarbourFront and Sentosa area.",
    gettingThere:
      "Its location near HarbourFront makes it convenient to combine a local hawker meal with a visit to the waterfront, VivoCity or Sentosa.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Seah+Im+Food+Centre+Singapore",
  },
  {
    id: "telok-blangah-crescent",
    number: "10",
    title: "Telok Blangah Crescent Market & Food Centre",
    location: "Telok Blangah Crescent",
    image: "/images/telok-blangah-crescent-market-food-centre.webp",
    description:
      "A neighbourhood market and food centre serving the Telok Blangah community. It is one of several local food destinations that Depot Heights residents can explore in the wider Telok Blangah neighbourhood.",
    gettingThere:
      "Located within the wider Telok Blangah neighbourhood, this is one of the local food centres accessible from the Depot Heights area.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Telok+Blangah+Crescent+Market+Food+Centre+Singapore",
  },
  {
    id: "telok-blangah",
    number: "11",
    title: "Telok Blangah Food Centre",
    location: "Telok Blangah Drive",
    image: "/images/telok-blangah-food-centre.webp",
    description:
      "Another local food destination in the Telok Blangah area, offering residents another opportunity to explore neighbourhood hawker food beyond the immediate Depot Road and Bukit Merah area.",
    gettingThere:
      "A local food option within the wider Telok Blangah neighbourhood, suitable for residents exploring nearby hawker centres and markets.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Telok+Blangah+Food+Centre+Singapore",
  },
];

const hiddenGems = [
  {
    id: "zion-riverside",
    number: "12",
    title: "Zion Riverside Food Centre",
    location: "Zion Road / Singapore River",
    image: "/images/zion-riverside-food-centre.webp",
    description:
      "A local food destination near Zion Road and the Singapore River. For Depot Heights residents, it makes a good destination for a longer local-food outing and is especially suitable for those who enjoy cycling around Singapore's neighbourhoods.",
    gettingThere:
      "Cycling is a practical option for residents who enjoy exploring the surrounding neighbourhoods. Approximately 4 km from Depot Heights by bicycle.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Zion+Riverside+Food+Centre+Singapore",
  },
  {
    id: "beo-crescent",
    number: "13",
    title: "Beo Crescent Market",
    location: "Beo Crescent",
    image: "/images/beo-crescent-market.webp",
    description:
      "A quieter neighbourhood food destination in the Tiong Bahru area. Beo Crescent Market is a good option for residents who enjoy discovering less prominent local food spots away from the better-known hawker centres.",
    gettingThere:
      "A convenient addition to a wider Tiong Bahru food outing, where residents can combine a visit with Tiong Bahru Food Centre and the surrounding cafés, shops and neighbourhood streets.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Beo+Crescent+Market+Singapore",
  },
  {
    id: "havelock-road",
    number: "14",
    title: "Havelock Road Cooked Food Centre",
    location: "Havelock Road",
    image: "/images/havelock-road-cooked-food-centre.webp",
    description:
      "A lesser-known neighbourhood cooked-food destination around the Havelock Road area. It offers another opportunity to explore local food beyond the more familiar hawker centres.",
    gettingThere:
      "A good option to include in a wider local-food trip around Havelock Road and Tiong Bahru, particularly for residents who enjoy exploring Singapore's neighbourhood food centres.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Havelock+Road+Cooked+Food+Centre+Singapore",
  },
];

const alexandraVillageFoods = [
  { name: "AJ Delights Muffin", image: "/images/avfc-ajdelights-muffin.webp" },
  { name: "The Thunder Tea Story", image: "/images/avfc-the-thunder-tea-story.webp" },
  { name: "Xiao Long Bao", image: "/images/avfc-xiaolongbao.webp" },
  { name: "Claypot Chicken Rice", image: "/images/avfc-claypot-chickenrice.webp" },
  { name: "HK Yummy Soup", image: "/images/avfc-hk-yummysoup.webp" },
  { name: "Premium Hor Fun (Beef) #01-30", image: "/images/avfc-horfun-premium.webp" },
  { name: "Jin Pai Zi Char", image: "/images/avfc-jinpai-zichar.webp" },
  { name: "Soya Sauce Chicken", image: "/images/avfc-soya-sauce-chicken.webp" },
  { name: "Zhen Shan Mei Claypot Laksa", image: "/images/avfc-zhenshanmei-claypot-laksa.webp" },
];

const kengEngKeeFoods = [
  { name: "Butter Cereal Prawn", image: "/images/avfc-kek-butter-cereal-prawn.webp" },
  { name: "Roasted Chicken", image: "/images/avfc-kek-roasted-chicken.webp" },
  { name: "Coffee Pork Ribs", image: "/images/avfc-kek-coffee-porkribs.webp" },
  { name: "Golden Pearl Roll", image: "/images/avfc-kek-golden-pearl-roll.webp" },
  { name: "Prawn Paste Chicken", image: "/images/avfc-kek-prawn-paste-chicken.webp" },
  { name: "Curry Fish Head", image: "/images/avfc-kek-curry-fishhead.webp" },
];

const pohCheuFoods = [
  { name: " Abacus Seeds (Suan Pan Zi)", image: "/images/avfc-pohcheu-soonkueh(4).webp" },
  { name: "Soon Kueh (Ku Chye Kueh, Mang Kuang Kueh)", image: "/images/avfc-pohcheu-soonkueh(3).webp" },
  { name: "Ang Ku Kueh (Manago,Green Tea, Yam, Durian)", image: "/images/avfc-pohcheu-soonkueh(2).webp" },
  { name: "Classic Ang Ku Kueh and Peng Kueh (both in red colour)", image: "/images/avfc-pohcheu-soonkueh(1).webp" },
];

const tiongBahruFoods = [
  { name: "Tiong Bahru Rojak", image: "/images/tiong-bahru-rojok.webp" },
  { name: "Tian Tian Yuan Dessert", image: "/images/tiong-bahru-dessert-tiantianyuan.webp" },
  { name: "Tiong Bahru Vegetarian Food", image: "/images/tiong-bahru-vegetarian.webp" },
];

const margaretDriveFoods = [
  { name: "Fernando's Pizza", image: "/images/margaret-dr-fernandos-pizza.webp" },
  { name: "Longtong", image: "/images/margaret-dr-longtong.webp" },
  { name: "Hakka Thunder Tea Rice", image: "/images/margaret-dr-hakka-thunder-tea-rice.webp" },
];

const title = "Best Hawker Food Near Depot Heights | Local Food Guide";
const description =
  "Explore hawker centres, markets and local food destinations near Depot Heights, including Alexandra Village, ABC Brickworks, Margaret Drive, Tiong Bahru, Bukit Merah View and hidden local food gems.";
const canonical = "https://depot-heights.pages.dev/local-food";
const heroImage = "/images/avfc-bukit-merah.webp";
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  image={heroImage}
  imageAlt="Alexandra Village Food Centre near Depot Heights"
>
  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">BEST HAWKER FOOD NEAR DEPOT HEIGHTS</p>
        <h1>
          Good food
          <span>close to home.</span>
        </h1>
        <p class="hero-text">
          Depot Heights is surrounded by established neighbourhoods
          with plenty of good food choices. Explore hawker centres,
          markets, traditional food shops and neighbourhood favourites
          around Bukit Merah, Alexandra, Queenstown, Tiong Bahru,
          HarbourFront and Telok Blangah.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#hawker-food">
            Explore local food
          </a>
          <a class="button secondary" href="/cafes">
            Explore cafés
          </a>
        </div>
      </div>

      <div class="hero-card">
        <img
          src={heroImage}
          alt="Alexandra Village Food Centre near Depot Heights"
          width="600"
          height="400"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hero-card-overlay">
          <p>DEPOT HEIGHTS</p>
          <div class="hero-card-line"></div>
          <strong>
            Hawker favourites.<br />
            Neighbourhood food.
          </strong>
        </div>
      </div>
    </section>

    <section class="intro">
      <p class="eyebrow">LOCAL FOOD AROUND DEPOT HEIGHTS</p>
      <h2>Good food is part of the neighbourhood.</h2>
      <p>
        From Alexandra Village and ABC Brickworks to Margaret Drive,
        Tiong Bahru and Bukit Merah View, there are many local food
        destinations within the wider neighbourhood. Further afield,
        hidden gems such as Zion Riverside, Beo Crescent and Havelock
        Road offer more opportunities to explore.
      </p>
    </section>

    <section class="section-grid" id="hawker-food">
      {
        featuredFoodCentres.map((centre) => (
          <article class="section-card" id={centre.id}>
            <div class="section-number">{centre.number}</div>
            <div>
              <p class="eyebrow">{centre.location}</p>
              <h2>{centre.title}</h2>
              <p class="section-description">{centre.description}</p>
              
              <div class="main-food-image">
                <img
                  src={centre.image}
                  alt={centre.title}
                  width="800"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="info-row">
                <div class="transport-note">
                  <p class="transport-eyebrow">Getting there from Depot Heights</p>
                  <p>{centre.gettingThere}</p>
                </div>
                <a
                  class="map-button"
                  href={centre.mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span aria-hidden="true">📍</span>
                  View on Google Maps
                </a>
              </div>

              {centre.id === "alexandra-village" && (
                <div class="nearby-food">
                  <div class="nearby-heading">
                    <p class="eyebrow">ALEXANDRA VILLAGE FOOD GUIDE</p>
                    <h3>Local food favourites to explore</h3>
                    <p>
                      Alexandra Village Food Centre and the surrounding
                      Bukit Merah Lane 1 area offer plenty of local food
                      choices. Check out these great food recommendations.
                    </p>
                  </div>

                  <div class="food-grid ten-items">
                    {alexandraVillageFoods.map((food) => (
                      <article class="food-card">
                        <img
                          src={food.image}
                          alt={food.name}
                          width="300"
                          height="190"
                          loading="lazy"
                          decoding="async"
                        />
                        <div class="food-card-content">
                          <h4>{food.name}</h4>
                        </div>
                      </article>
                    ))}
                  </div>

                  <div class="nearby-business">
                    <div class="business-heading">
                      <p class="business-location">123 Bukit Merah Lane 1</p>
                      <h4>Kiroi Japanese Cheesecake</h4>
                      <p>
                        Located in the vicinity of Alexandra Village and Bukit Merah Lane 1. Be sure to grab Kiroi’s famous Japanese cheesecake while exploring the local food scene.
                      </p>
                    </div>

                    <div class="single-food-card">
                      <article class="food-card">
                        <img
                          src="/images/avfc-japanese-cheesecake.webp"
                          alt="Kiroi Japanese Cheesecake at 123 Bukit Merah Lane 1"
                          width="400"
                          height="300"
                          loading="lazy"
                          decoding="async"
                        />
                        <div class="food-card-content">
                          <h4>Kiroi Japanese Cheesecake</h4>
                          <a
                            class="small-map-link"
                            href="https://www.google.com/maps/search/?api=1&query=123+Bukit+Merah+Lane+1+Singapore"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            📍 View 123 Bukit Merah Lane 1 on Google Maps
                          </a>
                        </div>
                      </article>
                    </div>
                  </div>

                  <div class="nearby-business">
                    <div class="business-heading">
                      <p class="business-location">124 Bukit Merah Lane 1</p>
                      <h4>Keng Eng Kee Seafood</h4>
                      <p>Keng Eng Kee Seafood has earned its reputation as one of Singapore's top zi-char destinations and even celebrities have been spotted savouring its famed creations. From the smoky, coffee pork ribs to the indulgent Chilli Crab, every dish bursts with wok hei and bold flavours. Check out these recommended dishes:</p>
                    </div>

                    <div class="food-grid six-items">
                      {kengEngKeeFoods.map((food) => (
                        <article class="food-card">
                          <img
                            src={food.image}
                            alt={food.name}
                            width="300"
                            height="190"
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="food-card-content">
                            <h4>{food.name}</h4>
                          </div>
                        </article>
                      ))}
                    </div>

                    <a
                      class="small-map-link"
                      href="https://www.google.com/maps/search/?api=1&query=124+Bukit+Merah+Lane+1+Singapore"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      📍 View 124 Bukit Merah Lane 1 on Google Maps
                    </a>
                  </div>

                  <div class="nearby-business">
                    <div class="business-heading">
                      <p class="business-location">127 Bukit Merah Lane 1</p>
                      <h4>Poh Cheu</h4>
                      <p>Poh Cheu isn't just a neighbourhood favourite, it's a Michelin Plate recipient that has been perfecting traditional kueh since 1985. Located at Bukit Merah Lane 1, Famous for its handmade Soon Kueh - Ku Chye Kueh (Chives Kueh) and Mang Kuang Kueh (Turnip. Do not missed Ang Ku Kueh chewy, mochi-like skin and an exciting array of flavours from classic Peanut to Mango, Green tea, Yam, Durian, Coffee and Black Sesame. As well as Abacus Seeds (Suan Pan Zi) goes well with their free free chilli paste.</p>
                    </div>

                    <div class="food-grid four-items">
                      {pohCheuFoods.map((food) => (
                        <article class="food-card">
                          <img
                            src={food.image}
                            alt={food.name}
                            width="300"
                            height="190"
                            loading="lazy"
                            decoding="async"
                          />
                          <div class="food-card-content">
                            <h4>{food.name}</h4>
                          </div>
                        </article>
                      ))}
                    </div>

                    <a
                      class="small-map-link"
                      href="https://www.google.com/maps/search/?api=1&query=127+Bukit+Merah+Lane+1+Singapore"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      📍 View 127 Bukit Merah Lane 1 on Google Maps
                    </a>
                  </div>
                </div>
              )}

              {centre.id === "tiong-bahru" && (
                <div class="recommended-section">
                  <h3>Recommended local food</h3>
                  <div class="food-grid three-items">
                    {tiongBahruFoods.map((food) => (
                      <article class="food-card">
                        <img
                          src={food.image}
                          alt={food.name}
                          width="300"
                          height="190"
                          loading="lazy"
                          decoding="async"
                        />
                        <div class="food-card-content">
                          <h4>{food.name}</h4>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              )}

              {centre.id === "margaret-drive" && (
                <div class="recommended-section">
                  <h3>Recommended local food</h3>
                  <div class="food-grid three-items">
                    {margaretDriveFoods.map((food) => (
                      <article class="food-card">
                        <img
                          src={food.image}
                          alt={food.name}
                          width="300"
                          height="190"
                          loading="lazy"
                          decoding="async"
                        />
                        <div class="food-card-content">
                          <h4>{food.name}</h4>
                        </div>
                      </article>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </article>
        ))
      }

      {
        otherFoodCentres.map((centre) => (
          <article class="section-card" id={centre.id}>
            <div class="section-number">{centre.number}</div>
            <div>
              <p class="eyebrow">{centre.location}</p>
              <h2>{centre.title}</h2>
              <p class="section-description">{centre.description}</p>
              <div class="main-food-image">
                <img
                  src={centre.image}
                  alt={centre.title}
                  width="800"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="info-row">
                <div class="transport-note">
                  <p class="transport-eyebrow">Getting there from Depot Heights</p>
                  <p>{centre.gettingThere}</p>
                </div>
                <a
                  class="map-button"
                  href={centre.mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span aria-hidden="true">📍</span>
                  View on Google Maps
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </section>

    <section class="hidden-gems-section" id="hidden-gems">
      <div class="hidden-gems-heading">
        <p class="eyebrow">HIDDEN GEMS</p>
        <h2>Worth the extra trip.</h2>
        <p>
          These lesser-known food destinations are a little further
          from Depot Heights, but are worth discovering for residents
          who enjoy exploring Singapore's neighbourhood food scene.
        </p>
      </div>

      <div class="section-grid hidden-gems-grid">
        {
          hiddenGems.map((centre) => (
            <article class="section-card" id={centre.id}>
              <div class="section-number">{centre.number}</div>
              <div>
                <p class="eyebrow">{centre.location}</p>
                <h2>{centre.title}</h2>
                <p class="section-description">{centre.description}</p>
                <div class="main-food-image">
                  <img
                    src={centre.image}
                    alt={centre.title}
                    width="800"
                    height="480"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="info-row">
                  <div class="transport-note">
                    <p class="transport-eyebrow">Getting there from Depot Heights</p>
                    <p>{centre.gettingThere}</p>
                  </div>
                  <a
                    class="map-button"
                    href={centre.mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
