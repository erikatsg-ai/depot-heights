---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/schools-education"
  image="/images/schools-education-hero.webp"
  imageAlt="Schools near Depot Heights"
>
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">DEPOT HEIGHTS · SCHOOLS & EDUCATION</p>
      <h1>
        Learning
        <span>within reach.</span>
      </h1>
      <p class="hero-text">
        Starting seamlessly from <strong>Bus Stop Blk 110 (Depot Road)</strong>, families at Depot Heights benefit from direct access via public buses (57, 175, 195) to a broad educational network spanning primary schools, secondary schools, junior colleges, polytechnics, and university options.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#primary-schools">Explore schools</a>
        <a class="button button-secondary" href="/">Back to neighbourhood guide</a>
      </div>
    </div>
    <div class="hero-image">
      <img src="/images/schools-education-hero.webp" alt="Schools near Depot Heights" loading="eager" decoding="async" />
    </div>
  </section>

  <section class="section introduction-section">
    <div class="intro-grid">
      <div class="section-heading">
        <p class="eyebrow">SCHOOLS & EDUCATION</p>
        <h2>A broad education network connected straight from Depot Road.</h2>
      </div>
      <div class="intro-copy">
        <p>
          Boarding from Bus Stop Blk 110 connects residents smoothly to major transport nodes like Labrador Park MRT, Queenstown MRT, and Bukit Merah Central, mapping out straightforward travel to schools across the island.
        </p>
        <p>
          Explore the updated travel distances, durations, and transit paths below tailored explicitly for journeys starting right outside your doorstep at Block 110.
        </p>
      </div>
    </div>
    </section>

  <section class="section education-section" id="primary-schools">
    <div class="section-heading">
      <p class="eyebrow">01 · PRIMARY SCHOOLS</p>
      <h2>Primary Schools</h2>
      <p>Primary options mapped with travel details starting from Bus Stop Blk 110, Depot Road.</p>
    </div>
    <div class="cards">
      {primarySchools.map((school) => (
        <article class="card">
          <button class="card-image thumb-trigger" type="button" data-full={school.image} aria-label={`Enlarge photo of ${school.name}`}>
            <img src={school.image} alt={school.name} loading="lazy" decoding="async" />
            <span class="zoom-hint">Click to enlarge</span>
          </button>
          <div class="card-body">
            <h3>{school.name}</h3>
            <p class="travel-badge">{school.travel}</p>
            <p>{school.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section education-section alt-section" id="secondary-schools">
    <div class="section-heading">
      <p class="eyebrow">02 · SECONDARY SCHOOLS</p>
      <h2>Secondary Schools</h2>
      <p>Secondary options with transit guides originating from Depot Road.</p>
    </div>
    <div class="cards">
      {secondarySchools.map((school) => (
        <article class="card">
          <button class="card-image thumb-trigger" type="button" data-full={school.image} aria-label={`Enlarge photo of ${school.name}`}>
            <img src={school.image} alt={school.name} loading="lazy" decoding="async" />
            <span class="zoom-hint">Click to enlarge</span>
          </button>
          <div class="card-body">
            <h3>{school.name}</h3>
            <p class="travel-badge">{school.travel}</p>
            <p>{school.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section education-section" id="junior-colleges">
    <div class="section-heading">
      <p class="eyebrow">03 · JUNIOR COLLEGE</p>
      <h2>Junior College</h2>
      <p>Pre-university pathways including Anglo-Chinese Junior College and Hwa Chong Institution.</p>
    </div>
    <div class="cards">
      {juniorColleges.map((school) => (
        <article class="card">
          <button class="card-image thumb-trigger" type="button" data-full={school.image} aria-label={`Enlarge photo of ${school.name}`}>
            <img src={school.image} alt={school.name} loading="lazy" decoding="async" />
            <span class="zoom-hint">Click to enlarge</span>
          </button>
          <div class="card-body">
            <h3>{school.name}</h3>
            <p class="travel-badge">{school.travel}</p>
            <p>{school.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section education-section alt-section" id="polytechnics">
    <div class="section-heading">
      <p class="eyebrow">04 · POLYTECHNICS</p>
      <h2>Polytechnics</h2>
      <p>Featuring Singapore Polytechnic and Ngee Ann Polytechnic with travel directions from Blk 110.</p>
    </div>
    <div class="cards">
      {polytechnics.map((polytechnic) => (
        <article class="card">
          <button class="card-image thumb-trigger" type="button" data-full={polytechnic.image} aria-label={`Enlarge photo of ${polytechnic.name}`}>
            <img src={polytechnic.image} alt={polytechnic.name} loading="lazy" decoding="async" />
            <span class="zoom-hint">Click to enlarge</span>
          </button>
          <div class="card-body">
            <h3>{polytechnic.name}</h3>
            <p class="travel-badge">{polytechnic.travel}</p>
            <p>{polytechnic.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section education-section" id="university">
    <div class="section-heading">
      <p class="eyebrow">05 · UNIVERSITY</p>
      <h2>University</h2>
      <p>Higher-education connections from Depot Heights to NUS and tertiary networks.</p>
    </div>
    <div class="cards single-card-grid">
      {university.map((uni) => (
        <article class="card">
          <button class="card-image thumb-trigger" type="button" data-full={uni.image} aria-label={`Enlarge photo of ${uni.name}`}>
            <img src={uni.image} alt={uni.name} loading="lazy" decoding="async" />
            <span class="zoom-hint">Click to enlarge</span>
          </button>
          <div class="card-body">
            <h3>{uni.name}</h3>
            <p class="travel-badge">{uni.travel}</p>
            <p>{uni.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section education-section alt-section" id="international-schools">
    <div class="section-heading">
      <p class="eyebrow">06 · INTERNATIONAL & PRIVATE SCHOOLS</p>
      <h2>International Schools</h2>
      <p>Families seeking international curricula or private institutions can also consider these options across Singapore.</p>
    </div>
    <div class="cards">
      {internationalSchools.map((item) => (
        <article class="card">
          <button class="card-image thumb-trigger" type="button" data-full={item.image} aria-label={`Enlarge photo of ${item.name}`}>
            <img src={item.image} alt={item.name} loading="lazy" decoding="async" />
            <span class="zoom-hint">Click to enlarge</span>
          </button>
          <div class="card-body">
            <h3>{item.name}</h3>
            <p class="travel-badge">{item.travel}</p>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section education-section" id="preschool-childcare">
    <div class="section-heading">
      <p class="eyebrow">07 · PRESCHOOL & CHILDCARE</p>
      <h2>Preschool & Childcare</h2>
      <p>Families with younger children have access to preschool and childcare options across the surrounding residential neighbourhoods.</p>
    </div>
    <div class="cards">
      {preschools.map((item) => (
        <article class="card text-only-card">
          <div class="card-body">
            <h3>{item.name}</h3>
            {item.location && <p class="location-badge">{item.location}</p>}
            <p class="travel-badge">{item.travel}</p>
            <p>{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Native HTML Dialog Modal -->
  <dialog id="imageModal" class="slideshow-dialog" aria-label="Enlarged image preview">
    <div class="dialog-controls">
      <button class="dialog-close" type="button" aria-label="Close modal" data-close>×</button>
    </div>
    <div class="dialog-body">
      <img class="dialog-main-img" id="modalImage" src="" alt="Enlarged view" loading="lazy" decoding="async" />
    </div>
  </dialog>

  <section class="closing-section">
    <div class="closing-inner">
      <p class="eyebrow">PLANNING FOR EDUCATION</p>
      <h2>Seamless commuting from Bus Stop Blk 110, Depot Road.</h2>
      <p>
        School admission, enrolment availability, distance and eligibility requirements can change over time. Families should check the relevant school's official information and current admission requirements when making education decisions.
      </p>
      <div class="closing-actions">
        <a class="button button-primary" href="/location">Explore Location</a>
        <a class="button button-secondary" href="/transport">Explore Transport</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const modal = document.getElementById("imageModal") as HTMLDialogElement;
    const modalImg = document.getElementById("modalImage") as HTMLImageElement;
    const closeBtn = modal?.querySelector("[data-close]");

    document.querySelectorAll(".thumb-trigger").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const fullSrc = trigger.getAttribute("data-full");
        if (fullSrc && modal && modalImg) {
          modalImg.src = fullSrc;
          modal.showModal();
          document.body.style.overflow = "hidden";
        }
      });
    });

    const closeModal = () => {
      if (modal) {
        modal.close();
        document.body.style.overflow = "";
      }
    };

    closeBtn?.addEventListener("click", closeModal);

    modal?.addEventListener("click", (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    modal?.addEventListener("cancel", () => {
      document.body.style.overflow = "";
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    min-height: 600px;
    background: #e8f0e8;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px clamp(30px, 6vw, 90px);
  }

  .eyebrow {
    margin: 0 0 16px;
    color: #2b6e52;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(45px, 6vw, 80px);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    display: block;
    color: #2b6e52;
  }

  .hero-text {
    max-width: 650px;
    margin: 28px 0 0;
    color: #52625a;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions,
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
    text-decoration: none;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #2b6e52;
    color: #ffffff;
  }

  .button-secondary {
    border: 1px solid #2b6e52;
    color: #2b6e52;
  }

  .hero-image {
    min-height: 600px;
    overflow: hidden;
    background: #dce7dd;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    min-height: 600px;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .section {
    padding: 95px 5vw;
  }

  .introduction-section {
    background: #ffffff;
  }

  .alt-section {
    background: #f7f8f3;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
    max-width: 1300px;
    margin: 0 auto 65px;
  }

  .section-heading {
    max-width: 900px;
    margin-bottom: 55px;
  }

  .intro-grid .section-heading {
    margin: 0;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .section-heading p:not(.eyebrow) {
    max-width: 760px;
    margin: 22px 0 0;
    color: #5d6b64;
    font-size: 18px;
    line-height: 1.8;
  }

  .intro-copy {
    color: #52625a;
    font-size: 17px;
    line-height: 1.85;
  }

  .intro-copy p {
    margin: 0 0 20px;
  }

  .intro-copy p:last-child {
    margin-bottom: 0;
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    max-width: 1300px;
    margin: 0 auto;
  }

  .highlight-card {
    min-height: 220px;
    padding: 30px;
    border-radius: 20px;
    background: #f7f8f3;
    border: 1px solid rgba(24, 49, 38, 0.08);
  }

  .highlight-icon {
    display: block;
    margin-bottom: 18px;
    font-size: 30px;
  }

  .highlight-card h3 {
    margin: 0;
    font-size: 25px;
    line-height: 1.2;
  }

  .highlight-card p {
    margin: 12px 0 0;
    color: #5d6b64;
    font-size: 15px;
    line-height: 1.75;
  }

  .education-section {
    scroll-margin-top: 100px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
  }

  .single-card-grid {
    grid-template-columns: minmax(0, 420px);
  }

  .card {
    overflow: hidden;
    border-radius: 20px;
    background: #ffffff;
    border: 1px solid rgba(24, 49, 38, 0.08);
    box-shadow: 0 12px 32px rgba(24, 47, 34, 0.06);
    display: flex;
    flex-direction: column;
  }

  .text-only-card {
    justify-content: flex-start;
  }

  .card-image {
    width: 100%;
    height: 260px;
    overflow: hidden;
    background: #dce7dd;
    position: relative;
    cursor: pointer;
    border: none;
    padding: 0;
    display: block;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .card-image:hover img {
    transform: scale(1.04);
  }

  .zoom-hint {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.6);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 4px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .card-image:hover .zoom-hint {
    opacity: 1;
  }

  .card-body {
    padding: 26px;
    flex: 1;
  }

  .card-body h3 {
    margin: 0;
    font-size: 28px;
    line-height: 1.15;
  }

  .travel-badge,
