---
import Layout from "../layouts/Layout.astro";

const highlights = [
  {
    title: "About Depot Heights",
    description: "Learn about Depot Heights, its location in Bukit Merah and what makes the neighbourhood a distinctive place to live.",
    href: "/about-depot-heights",
  },
  {
    title: "Amenities",
    description: "Explore estate facilities, outdoor recreation, sheltered walkways, everyday conveniences and Depot Heights Shopping Centre.",
    href: "/amenities",
  },
  {
    title: "Healthcare",
    description: "Find nearby family clinics, polyclinics, public hospitals, private hospitals and specialist medical care.",
    href: "/healthcare",
  },
  {
    title: "Schools & Education",
    description: "Discover primary and secondary schools, junior colleges and universities accessible from Depot Heights.",
    href: "/schools-education",
  },
  {
    title: "Transport",
    description: "See how Depot Heights connects to Bukit Merah, HarbourFront, the CBD and other parts of Singapore.",
    href: "/transport",
  },
  {
    title: "Lifestyle & Nature",
    description: "Explore parks, heritage sites, cafés, restaurants, arts, shopping and leisure destinations around the neighbourhood.",
    href: "/living-around-depot-heights",
  },
];

const livingSections = [
  {
    title: "Food & Hawker Centres",
    description: "Explore nearby hawker centres and local food destinations around Bukit Merah and the surrounding neighbourhoods.",
    href: "/local-food",
  },
  {
    title: "Cafés",
    description: "Discover cafés close to Depot Heights, including convenient options right at your doorstep and popular nearby coffee spots.",
    href: "/cafes",
  },
  {
    title: "Restaurants",
    description: "Find restaurants and dining destinations around Depot Heights, Bukit Merah, Alexandra and nearby areas.",
    href: "/restaurants",
  },
  {
    title: "Parks & Nature",
    description: "Explore Telok Blangah Hill, Mount Faber, Henderson Waves, the Southern Ridges and other nearby green spaces.",
    href: "/parks-pcn",
  },
  {
    title: "Shopping & Retail",
    description: "Discover everyday shopping, retail destinations and major centres including IKEA, Great World City and VivoCity.",
    href: "/retail-shopping",
  },
  {
    title: "Sports & Recreation",
    description: "Explore sports facilities, outdoor recreation and places to stay active around Depot Heights and the wider neighbourhood.",
    href: "/sports-recreation",
  },
];

const historySections = [
  {
    title: "History of Depot Heights",
    description: "Discover the story of Depot Heights and the wider Depot Road area, including the neighbourhood's changing landscape and heritage.",
    href: "/history-of-depot-road",
  },
  {
    title: "Depot Heights Location",
    description: "Understand where Depot Heights sits within Bukit Merah and how the estate connects to surrounding districts.",
    href: "/location",
  },
];
---

<Layout
  title="Depot Heights | Neighbourhood Guide, Bukit Merah, Singapore"
  description="Discover Depot Heights in Bukit Merah neighbourhood covering good food, cafes, restaurants, shopping, healthcare, schools, transport, parks and recreation."
  canonical="https://depot-heights.pages.dev/"
  image="/images/depot-heights-hero.webp"
>
  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">
          DEPOT HEIGHTS · BUKIT MERAH · SINGAPORE
        </p>

        <h1>
          Life at
          <span>Depot Heights.</span>
        </h1>

        <p class="hero-text">
          A neighbourhood guide to living, dining, nature and everyday
          convenience around Depot Heights in Bukit Merah.
        </p>

        <p class="hero-subtext">
          Discover the places, facilities and connections that make
          Depot Heights a convenient home — from local hawker centres
          and cafés to parks, transport, healthcare, schools and
          shopping.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="/about-depot-heights">
            Discover Depot Heights
          </a>

          <a class="button secondary" href="/amenities">
            Explore amenities
          </a>
        </div>
      </div>

      <div class="hero-card">
        <img
          src="/images/depot-heights-hero.webp"
          alt="Depot Heights in Bukit Merah, Singapore"
          loading="eager"
          width="1100"
          height="588"
        />

        <div class="hero-card-overlay">
          <p>DEPOT HEIGHTS</p>

          <div class="hero-card-line"></div>

          <strong>
            Living, Dining,<br />
            Nature & Convenience.
          </strong>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro">
      <p class="eyebrow">
        WELCOME TO DEPOT HEIGHTS
      </p>

      <h2>
        A neighbourhood guide for residents and visitors.
      </h2>

      <p>
        Depot Heights is a residential neighbourhood in Bukit Merah,
        Singapore. This website brings together useful information
        about the estate and the places around it, helping residents
        and visitors discover what is available close to home.
      </p>

      <p>
        Whether you are looking for somewhere to eat, a nearby park,
        a convenient bus connection, healthcare services, schools,
        or shopping, explore the neighbourhood through the guides below.
      </p>
    </section>

    <!-- QUICK ACCESS -->
    <section class="content-section" id="explore">
      <div class="section-heading">
        <p class="eyebrow">
          EXPLORE DEPOT HEIGHTS
        </p>

        <h2>
          Everything around the neighbourhood, in one place.
        </h2>

        <p>
          Start with the areas that matter most to everyday life at
          Depot Heights.
        </p>
      </div>

      <div class="highlight-grid">
        {
          highlights.map((item, index) => (
            <a class="highlight-card" href={item.href}>
              <div class="card-number">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="text-link">Explore →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- LIVING AROUND DEPOT HEIGHTS -->
    <section class="content-section soft-section">
      <div class="section-heading">
        <p class="eyebrow">
          LIVING AROUND DEPOT HEIGHTS
        </p>

        <h2>
          Food, nature, shopping and recreation.
        </h2>

        <p>
          Beyond the estate itself, Depot Heights is surrounded by a
          wide range of places to eat, relax, shop and enjoy the
          outdoors.
        </p>
      </div>

      <div class="living-grid">
        {
          livingSections.map((item) => (
            <article class="living-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a class="text-link" href={item.href}>
                Explore {item.title} →
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- FEATURED NEIGHBOURHOOD -->
    <section class="neighbourhood-feature">
      <div class="feature-image">
        <img
          src="/images/depot-heights-shopping-centre.webp"
          alt="Depot Heights Shopping Centre at Block 108 Depot Road"
          loading="lazy"
          width="800"
          height="450"
        />
      </div>

      <div class="feature-content">
        <p class="eyebrow">
          DEPOT HEIGHTS SHOPPING CENTRE
        </p>

        <h2>
          Everyday convenience is right at your doorstep.
        </h2>

        <p>
          Located at Block 108 Depot Road, Depot Heights Shopping
          Centre provides residents with convenient access to
          groceries, essential services, healthcare, dining, cafés
          and fitness facilities.
        </p>

        <a class="button primary" href="/amenities#shopping">
          Explore Depot Heights Shopping Centre
        </a>
      </div>
    </section>

    <!-- YOUTUBE VIDEO -->
    <section class="content-section">
      <div class="section-heading">
        <h2>See Depot Heights</h2>
        <p>A glimpse into the life and surroundings of our neighbourhood.</p>
      </div>
      <div class="video-container">
        <iframe
          src="https://www.youtube.com/embed/UGf3-ZhsV5s"
          title="Depot Heights Video"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy">
        </iframe>
      </div>
    </section>

    <!-- HISTORY & LOCATION -->
    <section class="content-section soft-section">
      <div class="section-heading">
        <p class="eyebrow">
          THE STORY OF THE NEIGHBOURHOOD
        </p>

        <h2>
          Understand Depot Heights and its surroundings.
        </h2>

        <p>
          Learn about the history of the area and discover where
          Depot Heights is located within Bukit Merah.
        </p>
      </div>

      <div class="history-grid">
        {
          historySections.map((item) => (
            <article class="history-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a class="text-link" href={item.href}>
                Explore {item.title} →
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>