---
import { YouTube } from 'astro-embed';
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import heroImg from '../assets/images/depot-heights-hero.webp';

const highlights = [
  {
    title: "About Depot Heights",
    description: "Learn about Depot Heights, its location in Bukit Merah and what makes the neighbourhood a distinctive place to live.",
    href: "/about-depot-heights/",
  },
  {
    title: "Amenities",
    description: "Explore estate facilities, outdoor recreation, sheltered walkways, everyday conveniences and Depot Heights Shopping Centre.",
    href: "/amenities/",
  },
  {
    title: "Healthcare",
    description: "Find nearby family clinics, polyclinics, public hospitals, private hospitals and specialist medical care.",
    href: "/healthcare/",
  },
  {
    title: "Schools & Education",
    description: "Discover primary and secondary schools, junior colleges and universities accessible from Depot Heights.",
    href: "/schools-education/",
  },
  {
    title: "Transport",
    description: "See how Depot Heights connects to Bukit Merah, HarbourFront, the CBD and other parts of Singapore.",
    href: "/transport/",
  },
  {
    title: "Lifestyle & Nature",
    description: "Explore parks, heritage sites, cafés, restaurants, arts, shopping and leisure destinations around the neighbourhood.",
    href: "/living-around-depot-heights/",
  },
];

const livingSections = [
  {
    title: "Food & Hawker Centres",
    description: "Explore nearby hawker centres and local food destinations around Bukit Merah and the surrounding neighbourhoods.",
    href: "/local-food/",
  },
  {
    title: "Cafés",
    description: "Discover cafés close to Depot Heights, including convenient options right at your doorstep and popular nearby coffee spots.",
    href: "/cafes/",
  },
  {
    title: "Restaurants",
    description: "Find restaurants and dining destinations around Depot Heights, Bukit Merah, Alexandra and nearby areas.",
    href: "/restaurants/",
  },
  {
    title: "Parks & Nature",
    description: "Explore Telok Blangah Hill, Mount Faber, Henderson Waves, the Southern Ridges and other nearby green spaces.",
    href: "/parks-pcn/",
  },
  {
    title: "Shopping & Retail",
    description: "Discover everyday shopping, retail destinations and major centres including IKEA, Great World City and VivoCity.",
    href: "/retail-shopping/",
  },
  {
    title: "Sports & Recreation",
    description: "Explore sports facilities, outdoor recreation and places to stay active around Depot Heights and the wider neighbourhood.",
    href: "/sports-recreation/",
  },
];

const historySections = [
  {
    title: "History of Depot Heights",
    description: "Discover the story of Depot Heights and the wider Depot Road area, including the neighbourhood's changing landscape and heritage.",
    href: "/history-of-depot-road/",
  },
  {
    title: "Depot Heights Location",
    description: "Understand where Depot Heights sits within Bukit Merah and how the estate connects to surrounding districts.",
    href: "/location/",
  },
];
---

<Image 
  src={heroImg} 
  alt="Depot Heights in Bukit Merah, Singapore" 
  width={720} 
  height={385} 
  format="webp" 
  quality={80} 
  loading="eager" 
  fetchpriority="high" 
/>

<Layout
  title="Depot Heights | Neighbourhood Guide, Bukit Merah, Singapore"
  description="Discover Depot Heights in Bukit Merah neighbourhood covering good food, cafes, restaurants, shopping, healthcare, schools, transport, parks and recreation."
  image="/images/depot-heights-hero.webp"
>
  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">
          DEPOT HEIGHTS · BUKIT MERAH · SINGAPORE
        </p>

        <h1>
          Life at
          <span>Depot Heights</span>
        </h1>

        <p class="hero-text">
          A neighbourhood guide to living, dining, nature and everyday
          convenience around Depot Heights in Bukit Merah.
        </p>

        <p class="hero-subtext">
          Discover the places, facilities and connections that make
          Depot Heights a convenient home — from local hawker centres
          and cafés to parks, transport, healthcare, schools and
          shopping.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/about-depot-heights/">
            Discover Depot Heights
          </a>

          <a class="button button-secondary" href="/amenities/">
            Explore amenities
          </a>
        </div>
      </div>

      <div class="hero-card">
        <img
          src="/images/depot-heights-hero.webp"
          alt="Depot Heights in Bukit Merah, Singapore"
          fetchpriority="high"
          decoding="async"
          width="1100"
          height="588"
        />

        <div class="hero-card-overlay">
          <p>DEPOT HEIGHTS</p>

          <div class="hero-card-line"></div>

          <strong>
            Living, Dining,<br />
            Nature & Convenience.
          </strong>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro">
      <p class="eyebrow">
        WELCOME TO DEPOT HEIGHTS
      </p>

      <h2>
        A neighbourhood guide for residents and visitors.
      </h2>

      <p>
        Depot Heights is a residential neighbourhood in Bukit Merah,
        Singapore. This website brings together useful information
        about the estate and the places around it, helping residents
        and visitors discover what is available close to home.
      </p>

      <p>
        Whether you are looking for somewhere to eat, a nearby park,
        a convenient bus connection, healthcare services, schools,
        or shopping, explore the neighbourhood through the guides below.
      </p>
    </section>

    <!-- QUICK ACCESS -->
    <section class="content-section" id="explore">
      <div class="section-heading">
        <p class="eyebrow">
          EXPLORE DEPOT HEIGHTS
        </p>

        <h2>
          Everything around the neighbourhood, in one place.
        </h2>

        <p>
          Start with the areas that matter most to everyday life at
          Depot Heights.
        </p>
      </div>

      <div class="highlight-grid">
        {
          highlights.map((item, index) => (
            <a class="highlight-card" href={item.href}>
              <div class="card-number">
                {String(index + 1).padStart(2, "0")}
              </div>

              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="text-link">Explore →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- LIVING AROUND DEPOT HEIGHTS -->
    <section class="content-section soft-section">
      <div class="section-heading">
        <p class="eyebrow">
          LIVING AROUND DEPOT HEIGHTS
        </p>

        <h2>
          Food, nature, shopping and recreation.
        </h2>

        <p>
          Beyond the estate itself, Depot Heights is surrounded by a
          wide range of places to eat, relax, shop and enjoy the
          outdoors.
        </p>
      </div>

      <div class="living-grid">
        {
          livingSections.map((item) => (
            <article class="living-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a class="text-link" href={item.href}>
                Explore {item.title} →
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- FEATURED NEIGHBOURHOOD -->
    <section class="neighbourhood-feature">
      <div class="feature-image">
        <img
          src="/images/depot-heights-shopping-centre.webp"
          alt="Depot Heights Shopping Centre at Block 108 Depot Road"
          decoding="async"
          width="800"
          height="450"
        />
      </div>

      <div class="feature-content">
        <p class="eyebrow">
          DEPOT HEIGHTS SHOPPING CENTRE
        </p>

        <h2>
          Everyday convenience is right at your doorstep.
        </h2>

        <p>
          Located at Block 108 Depot Road, Depot Heights Shopping
          Centre provides residents with convenient access to
          groceries, essential services, healthcare, dining, cafés
          and fitness facilities.
        </p>

        <a class="button button-primary" href="/amenities/#shopping">
          Explore Depot Heights Shopping Centre
        </a>
      </div>
    </section>

    <!-- YOUTUBE VIDEO -->
<section class="content-section">
  <div class="section-heading">
    <h2>See Depot Heights</h2>
    <p>A glimpse into the life and surroundings of our neighbourhood.</p>
  </div>
  <div class="video-container">
    <YouTube 
      id="UGf3-ZhsV5s" 
      title="Depot Heights Video" 
    />
  </div>
</section>

    <!-- HISTORY & LOCATION -->
    <section class="content-section soft-section">
      <div class="section-heading">
        <p class="eyebrow">
          THE STORY OF THE NEIGHBOURHOOD
        </p>

        <h2>
          Understand Depot Heights and its surroundings.
        </h2>

        <p>
          Learn about the history of the area and discover where
          Depot Heights is located within Bukit Merah.
        </p>
      </div>

      <div class="history-grid">
        {
          historySections.map((item) => (
            <article class="history-card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <a class="text-link" href={item.href}>
                Explore {item.title} →
              </a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Page-specific styles only - global styles in global.css */

  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    min-height: 600px;
    background: #e8f0e8;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px clamp(30px, 6vw, 90px);
  }

  .eyebrow {
    margin: 0 0 16px;
    color: #2b6e52;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(45px, 6vw, 80px);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    display: block;
    color: #2b6e52;
  }

  .hero-text {
    max-width: 650px;
    margin: 28px 0 0;
    color: #52625a;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-subtext {
    max-width: 650px;
    margin: 16px 0 0;
    color: #65736c;
    font-size: 16px;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    transition: transform 0.2s ease, background 0.2s ease;
    text-decoration: none;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #2b6e52;
    color: #ffffff;
  }

  .button-primary:hover {
    background: #235f47;
  }

  .button-secondary {
    border: 1px solid #2b6e52;
    color: #2b6e52;
  }

  .button-secondary:hover {
    background: rgba(43, 110, 82, 0.08);
  }

  .hero-card {
    position: relative;
    min-height: 360px;
    overflow: hidden;
    border-radius: 2rem;
    color: white;
    background: #315f4a;
    box-shadow: 0 25px 70px rgba(39, 102, 77, 0.18);
  }

  .hero-card img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
  }

  .hero-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(31, 72, 55, 0.05),
      rgba(31, 72, 55, 0.9)
    );
  }

  .hero-card-overlay {
    position: absolute;
    z-index: 2;
    right: 2rem;
    bottom: 2rem;
    left: 2rem;
  }

  .hero-card-overlay p {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .hero-card-line {
    width: 50px;
    height: 2px;
    margin: 1rem 0;
    background: white;
  }

  .hero-card-overlay strong {
    display: block;
    font-size: clamp(1.8rem, 3vw, 3rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 850px;
    margin: 0 auto;
    padding: 80px 5vw 40px;
    text-align: center;
  }

  .intro h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .intro p:not(.eyebrow) {
    max-width: 760px;
    margin: 22px auto 0;
    color: #5d6b64;
    font-size: 18px;
    line-height: 1.8;
  }

  .content-section {
    padding: 60px 5vw 80px;
  }

  .soft-section {
    background: #f7f8f3;
  }

  .section-heading {
    max-width: 850px;
    margin: 0 auto 50px;
    text-align: center;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .section-heading p:not(.eyebrow) {
    max-width: 700px;
    margin: 22px auto 0;
    color: #5d6b64;
    font-size: 18px;
    line-height: 1.8;
  }

  .highlight-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .highlight-card {
    display: flex;
    gap: 18px;
    padding: 28px;
    border-radius: 20px;
    background: #ffffff;
    border: 1px solid rgba(24, 49, 38, 0.08);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .highlight-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(24, 49, 38, 0.08);
  }

  .highlight-card .card-number {
    font-size: 24px;
    font-weight: 900;
    color: #2b6e52;
    opacity: 0.4;
    flex-shrink: 0;
    line-height: 1.2;
  }

  .highlight-card h3 {
    margin: 0 0 6px;
    color: #1d2924;
    font-size: 20px;
    line-height: 1.2;
  }

  .highlight-card p {
    margin: 0 0 12px;
    color: #5d6b64;
    font-size: 15px;
    line-height: 1.6;
  }

  .highlight-card .text-link {
    color: #2b6e52;
    font-weight: 700;
    font-size: 14px;
  }

  .living-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .living-card {
    padding: 28px;
    border-radius: 20px;
    background: #ffffff;
    border: 1px solid rgba(24, 49, 38, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .living-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(24, 49, 38, 0.08);
  }

  .living-card h3 {
    margin: 0 0 8px;
    color: #1d2924;
    font-size: 22px;
    line-height: 1.2;
  }

  .living-card p {
    margin: 0 0 16px;
    color: #5d6b64;
    font-size: 15px;
    line-height: 1.6;
  }

  .living-card .text-link {
    color: #2b6e52;
    font-weight: 700;
    font-size: 14px;
  }

  .neighbourhood-feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    padding: 80px 5vw;
    background: #e8f0e8;
  }

  .feature-image {
    overflow: hidden;
    border-radius: 24px;
    background: #dce7dd;
  }

  .feature-image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 320px;
    object-fit: cover;
  }

  .feature-content h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 50px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .feature-content p:not(.eyebrow) {
    max-width: 600px;
    margin: 20px 0 30px;
    color: #52625a;
    font-size: 18px;
    line-height: 1.8;
  }

  .video-container {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 20px;
    box-shadow: 0 12px 40px rgba(24, 49, 38, 0.1);
  }

  .video-container {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
  height: 0;
  overflow: hidden;
  border-radius: 8px; /* Optional: smooth corners */
}

/* Target both iframe and astro-embed web component */
.video-container iframe,
.video-container lite-youtube {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

  .history-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .history-card {
    padding: 28px;
    border-radius: 20px;
    background: #ffffff;
    border: 1px solid rgba(24, 49, 38, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .history-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(24, 49, 38, 0.08);
  }

  .history-card h3 {
    margin: 0 0 8px;
    color: #1d2924;
    font-size: 24px;
    line-height: 1.2;
  }

  .history-card p {
    margin: 0 0 16px;
    color: #5d6b64;
    font-size: 16px;
    line-height: 1.7;
  }

  .history-card .text-link {
    color: #2b6e52;
    font-weight: 700;
    font-size: 14px;
  }

  .text-link {
    color: #2b6e52;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
  }

  .text-link:hover {
    color: #1f513d;
  }

  @media (max-width: 1100px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-card {
      min-height: 280px;
      margin: 0 5vw 30px;
    }

    .hero-card img {
      min-height: 280px;
    }

    .hero-content {
      padding: 60px clamp(30px, 6vw, 90px);
    }

    .highlight-grid,
    .living-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .neighbourhood-feature {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .feature-image img {
      min-height: 280px;
    }
  }

  @media (max-width: 768px) {
    .highlight-grid,
    .living-grid,
    .history-grid {
      grid-template-columns: 1fr;
    }

    .hero-content {
      padding: 40px 24px;
    }

    .hero h1 {
      font-size: clamp(38px, 12vw, 60px);
    }

    .content-section {
      padding: 40px 5vw 60px;
    }

    .neighbourhood-feature {
      padding: 50px 5vw;
    }

    .feature-content h2 {
      font-size: clamp(28px, 6vw, 40px);
    }

    .highlight-card {
      padding: 20px;
    }

    .living-card {
      padding: 20px;
    }

    .history-card {
      padding: 20px;
    }

    .feature-image img {
      min-height: 220px;
    }
  }
</style>

