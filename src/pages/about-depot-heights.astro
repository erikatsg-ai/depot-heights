---
import Layout from "../layouts/Layout.astro";

const pageTitle =
  "About Depot Heights | HDB Estate at Depot Road, Bukit Merah";

const pageDescription =
  "Learn about Depot Heights, an established HDB residential estate in Bukit Merah, Singapore, covering Blocks 102 to 114, Depot Heights Shopping Centre and the neighbourhood around Depot Road.";

const estateFacts = [
  {
    number: "01",
    title: "Blocks 102 to 114",
    description:
      "Depot Heights is an established residential estate made up of HDB blocks in the Depot Road area of Bukit Merah.",
  },
  {
    number: "02",
    title: "Depot Heights Shopping Centre",
    description:
      "Located at 108 Depot Road, Depot Heights Shopping Centre serves the neighbourhood with everyday amenities and local services.",
  },
  {
    number: "03",
    title: "Bukit Merah",
    description:
      "The estate sits within the established Bukit Merah area, close to Alexandra, Redhill, Tiong Bahru, Telok Blangah and HarbourFront.",
  },
  {
    number: "04",
    title: "A Well-Established Neighbourhood",
    description:
      "Depot Heights combines residential living with convenient access to food, shopping, healthcare, education, transport, workplaces and green spaces.",
  },
];

const highlights = [
  {
    number: "01",
    title: "Established Residential Community",
    description:
      "Depot Heights is a mature residential estate where residents benefit from an established neighbourhood environment and convenient access to everyday amenities.",
  },
  {
    number: "02",
    title: "Everyday Convenience",
    description:
      "The nearby shopping centre and surrounding Bukit Merah neighbourhood provide access to food, services, retail and other practical amenities.",
  },
  {
    number: "03",
    title: "Connected Location",
    description:
      "The estate is positioned near major roads and public transport connections serving Alexandra, Bukit Merah, Telok Blangah, HarbourFront and central Singapore.",
  },
  {
    number: "04",
    title: "Close to Nature",
    description:
      "Residents are within reach of parks, trails and recreational destinations around Telok Blangah Hill, Mount Faber, HortPark, Labrador and the Southern Ridges.",
  },
];

const nearbyLinks = [
  {
    title: "Explore Depot Heights Location",
    description:
      "Discover nearby neighbourhoods, road connections, commercial hubs and green connections.",
    href: "/location",
  },
  {
    title: "Explore Public Transport",
    description:
      "See the main bus connections from the Depot Heights area and the key destinations they serve.",
    href: "/transport",
  },
];
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">ABOUT DEPOT HEIGHTS</p>

        <h1>
          An established
          <span>Bukit Merah neighbourhood.</span>
        </h1>

        <p class="hero-text">
          Depot Heights is an established HDB residential estate along Depot
          Road in Bukit Merah, Singapore. The estate is surrounded by a mix of
          residential neighbourhoods, food and shopping destinations,
          workplaces, schools, healthcare facilities, transport connections
          and green spaces.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#estate">
            Discover Depot Heights
          </a>

          <a class="button button-secondary" href="/location">
            Explore the location
          </a>
        </div>
      </div>

      <div class="hero-image">
        <img
          src="/images/depot-heights-location-hero.webp"
          alt="Depot Heights residential estate in Bukit Merah"
          loading="eager"
        />
      </div>
    </section>

    <section class="section intro-section" id="estate">
      <div class="intro-grid">
        <div class="section-heading">
          <p class="eyebrow">THE ESTATE</p>

          <h2>
            A residential estate in the heart of established Bukit Merah.
          </h2>
        </div>

        <div class="intro-copy">
          <p>
            Depot Heights is located along Depot Road in the Bukit Merah area
            of Singapore. The estate is made up of HDB residential blocks and
            benefits from its position between several established
            neighbourhoods.
          </p>

          <p>
            From Depot Heights, residents can reach Alexandra, Redhill, Tiong
            Bahru, Telok Blangah and HarbourFront, while also having access to
            workplaces, education and healthcare destinations across the
            southern and western parts of Singapore.
          </p>

          <p>
            The neighbourhood also offers access to parks, walking routes and
            green spaces, giving Depot Heights a useful balance between urban
            convenience and nature.
          </p>
        </div>
      </div>
    </section>

    <section class="section facts-section">
      <div class="section-heading">
        <p class="eyebrow">DEPOT HEIGHTS AT A GLANCE</p>

        <h2>
          The essentials about the neighbourhood.
        </h2>

        <p>
          Whether you are a long-time resident, a visitor or someone learning
          about the area for the first time, these are the key things to know
          about Depot Heights.
        </p>
      </div>

      <div class="facts-grid">
        {
          estateFacts.map((fact) => (
            <article class="fact-card">
              <span>{fact.number}</span>

              <h3>{fact.title}</h3>

              <p>{fact.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section shopping-section">
      <div class="shopping-grid">
        <div class="shopping-image">
          <img
            src="/images/depot-heights-shopping-centre.webp"
            alt="Depot Heights Shopping Centre at 108 Depot Road"
            loading="lazy"
          />
        </div>

        <div class="shopping-content">
          <p class="eyebrow">DEPOT HEIGHTS SHOPPING CENTRE</p>

          <h2>
            Everyday amenities close to home.
          </h2>

          <p>
            Depot Heights Shopping Centre at 108 Depot Road is an important
            local amenity for the surrounding estate. The centre provides
            convenient access to everyday services and neighbourhood
            businesses.
          </p>

          <p>
            Its location within the estate makes it part of the everyday
            rhythm of Depot Heights, serving residents who live in the
            surrounding blocks.
          </p>

          <a class="text-link" href="/living-around-depot-heights">
            Explore living around Depot Heights →
          </a>
        </div>
      </div>
    </section>

    <section class="section highlights-section">
      <div class="section-heading">
        <p class="eyebrow">WHY THE AREA STANDS OUT</p>

        <h2>
          More than just a place to live.
        </h2>

        <p>
          Depot Heights benefits from the combination of an established
          residential setting and its location within one of Singapore's
          well-connected southern districts.
        </p>
      </div>

      <div class="highlights-grid">
        {
          highlights.map((item) => (
            <article class="highlight-card">
              <span>{item.number}</span>

              <h3>{item.title}</h3>

              <p>{item.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section design-section">
      <div class="design-inner">
        <div>
          <p class="eyebrow">A RECOGNISED ESTATE</p>

          <h2>
            Depot Heights received an HDB Design Award in 2018.
          </h2>

          <p>
            The estate was recognised with an HDB Design Award in 2018. This
            forms part of the story of Depot Heights and its place within
            Singapore's public housing landscape.
          </p>
        </div>

        <div class="design-note">
          <strong>Depot Heights</strong>

          <p>
            An established HDB neighbourhood in Bukit Merah, shaped by its
            residential community and its surroundings.
          </p>
        </div>
      </div>
    </section>

    <section class="section connections-section">
      <div class="section-heading">
        <p class="eyebrow">EXPLORE THE NEIGHBOURHOOD</p>

        <h2>
          Discover what makes the Depot Heights location convenient.
        </h2>
      </div>

      <div class="links-grid">
        {
          nearbyLinks.map((link) => (
            <a class="link-card" href={link.href}>
              <span>→</span>

              <h3>{link.title}</h3>

              <p>{link.description}</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="closing-section">
      <div class="closing-inner">
        <p class="eyebrow">DEPOT HEIGHTS</p>

        <h2>
          Established living, everyday convenience and a well-connected
          southern location.
        </h2>

        <p>
          Depot Heights offers residents the advantages of living in an
          established Bukit Merah neighbourhood, with convenient access to
          transport, food, shopping, workplaces, education, healthcare, parks
          and the wider southern part of Singapore.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f7f8f3;
    color: #183126;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    min-height: 580px;
    background: #e8f0e8;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 75px clamp(30px, 6vw, 90px);
  }

  .eyebrow {
    margin: 0 0 16px;
    color: #2b6e52;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(45px, 6vw, 80px);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .hero h1 span {
    display: block;
    color: #2b6e52;
  }

  .hero-text {
    max-width: 680px;
    margin: 25px 0 0;
    color: #52625a;
    font-size: 17px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 800;
  }

  .button-primary {
    background: #2b6e52;
    color: #fff;
  }

  .button-secondary {
    border: 1px solid #2b6e52;
    color: #2b6e52;
  }

  .hero-image {
    min-height: 580px;
    overflow: hidden;
    background: #dce7dd;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    min-height: 580px;
    display: block;
    object-fit: cover;
  }

  .section {
    padding: 90px 5vw;
  }

  .section-heading {
    max-width: 850px;
    margin-bottom: 50px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .section-heading p:not(.eyebrow) {
    max-width: 720px;
    margin: 20px 0 0;
    color: #5d6b64;
    font-size: 17px;
    line-height: 1.8;
  }

  .intro-section {
    background: #fff;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    align-items: start;
  }

  .intro-grid .section-heading {
    margin-bottom: 0;
  }

  .intro-copy p {
    margin: 0 0 22px;
    color: #52625a;
    font-size: 17px;
    line-height: 1.85;
  }

  .facts-section {
    background: #f7f8f3;
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .fact-card {
    min-height: 270px;
    padding: 30px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid rgba(24, 49, 38, 0.08);
  }

  .fact-card > span,
  .highlight-card > span {
    display: block;
    margin-bottom: 16px;
    color: #2b6e52;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .fact-card h3,
  .highlight-card h3 {
    margin: 0;
    font-size: 26px;
    line-height: 1.15;
  }

  .fact-card p,
  .highlight-card p {
    margin: 15px 0 0;
    color: #5d6b64;
    font-size: 15px;
    line-height: 1.8;
  }

  .shopping-section {
    background: #e8f0e8;
  }

  .shopping-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .shopping-image {
    min-height: 450px;
    overflow: hidden;
    border-radius: 24px;
    background: #dce7dd;
  }

  .shopping-image img {
    width: 100%;
    height: 100%;
    min-height: 450px;
    display: block;
    object-fit: cover;
  }

  .shopping-content h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .shopping-content p:not(.eyebrow) {
    max-width: 650px;
    margin: 20px 0 0;
    color: #52625a;
    font-size: 17px;
    line-height: 1.8;
  }

  .text-link {
    display: inline-block;
    margin-top: 25px;
    color: #2b6e52;
    font-size: 13px;
    font-weight: 800;
  }

  .highlights-section {
    background: #fff;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .highlight-card {
    padding: 35px;
    border-radius: 22px;
    background: #f7f8f3;
    border: 1px solid rgba(24, 49, 38, 0.08);
  }

  .design-section {
    background: #235f47;
    color: #fff;
  }

  .design-inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 60px;
    align-items: center;
  }

  .design-inner .eyebrow {
    color: #c9e4d5;
  }

  .design-inner h2 {
    max-width: 800px;
    margin: 0;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .design-inner > div > p:not(.eyebrow) {
    max-width: 750px;
    margin: 22px 0 0;
    color: #d8e9df;
    font-size: 17px;
    line-height: 1.8;
  }

  .design-note {
    padding: 35px;
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }

  .design-note strong {
    display: block;
    color: #fff;
    font-size: 25px;
  }

  .design-note p {
    margin: 12px 0 0;
    color: #d8e9df;
    line-height: 1.8;
  }

  .connections-section {
    background: #f7f8f3;
  }

  .links-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .link-card {
    display: block;
    padding: 35px;
    border-radius: 22px;
    background: #fff;
    border: 1px solid rgba(24, 49, 38, 0.08);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .link-card:hover {
    transform: translateY(-4px);
    border-color: #2b6e52;
  }

  .link-card > span {
    display: block;
    margin-bottom: 18px;
    color: #2b6e52;
    font-size: 26px;
    font-weight: 800;
  }

  .link-card h3 {
    margin: 0;
    font-size: 29px;
    line-height: 1.15;
  }

  .link-card p {
    margin: 15px 0 0;
    color: #5d6b64;
    font-size: 16px;
    line-height: 1.8;
  }

  .closing-section {
    padding: 90px 5vw;
    background: #142f25;
    color: #fff;
  }

  .closing-inner {
    max-width: 900px;
  }

  .closing-inner .eyebrow {
    color: #c9e4d5;
  }

  .closing-inner h2 {
    margin: 0;
    font-size: clamp(38px, 5vw, 65px);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .closing-inner p:not(.eyebrow) {
    max-width: 760px;
    margin: 22px 0 0;
    color: #d8e9df;
    font-size: 17px;
    line-height: 1.8;
  }

  @media (max-width: 1050px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-image,
    .hero-image img {
      min-height: 450px;
    }

    .intro-grid,
    .shopping-grid,
    .design-inner {
      grid-template-columns: 1fr;
    }

    .facts-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .hero h1 {
      font-size: clamp(45px, 14vw, 70px);
    }

    .hero-image,
    .hero-image img {
      min-height: 350px;
    }

    .section,
    .closing-section {
      padding: 70px 24px;
    }

    .facts-grid,
    .highlights-grid,
    .links-grid {
      grid-template-columns: 1fr;
    }

    .shopping-image,
    .shopping-image img {
      min-height: 300px;
    }
  }
</style>