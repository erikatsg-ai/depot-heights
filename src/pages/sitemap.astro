---
import Layout from "../layouts/Layout.astro";

const sitemapSections = [
  {
    title: "Main",
    items: [
      {
        name: "Home",
        href: "/",
        description:
          "Return to the Depot Heights neighbourhood homepage.",
      },
      {
        name: "About Depot Heights",
        href: "/about-depot-heights",
        description:
          "Learn about Depot Heights and the neighbourhood around Blocks 102 to 114.",
      },
      {
        name: "Depot Heights Location",
        href: "/location",
        description:
          "Explore where Depot Heights is located and discover its surrounding neighbourhoods.",
      },
    ],
  },
  {
    title: "About Depot Heights",
    items: [
      {
        name: "History of Depot Heights",
        href: "/history-of-depot-road",
        description:
          "Discover the history and development of Depot Heights and the wider Depot Road area.",
      },
    ],
  },
  {
    title: "Living Around Depot Heights",
    items: [
      {
        name: "Amenities",
        href: "/amenities",
        description:
          "Explore everyday estate facilities, conveniences and amenities at Depot Heights.",
      },
      {
        name: "Sports & Recreation",
        href: "/sports-recreation",
        description:
          "Discover sports and recreational facilities around Depot Heights.",
      },
      {
        name: "Healthcare",
        href: "/healthcare",
        description:
          "Find nearby clinics, polyclinics, hospitals and specialist medical services.",
      },
      {
        name: "Schools & Education",
        href: "/schools-education",
        description:
          "Explore primary schools, secondary schools, junior colleges and universities nearby.",
      },
      {
        name: "Food & Hawker Centres",
        href: "/local-food",
        description:
          "Discover hawker centres and local food options around Depot Heights.",
      },
      {
        name: "Cafés",
        href: "/cafes",
        description:
          "Explore cafés and coffee spots around Depot Heights and nearby neighbourhoods.",
      },
      {
        name: "Restaurants",
        href: "/restaurants",
        description:
          "Discover restaurants and dining destinations around Depot Heights.",
      },
      {
        name: "Parks & Nature",
        href: "/parks-pcn",
        description:
          "Explore parks, trails, greenery and nature destinations around Depot Heights.",
      },
      {
        name: "Lifestyle & Leisure",
        href: "/living-around-depot-heights",
        description:
          "Discover heritage, arts, leisure, lifestyle and recreational destinations nearby.",
      },
      {
        name: "Shopping & Retail",
        href: "/retail-shopping",
        description:
          "Explore shopping centres, retail destinations and everyday shopping options.",
      },
      {
        name: "Transport",
        href: "/transport",
        description:
          "Find out how Depot Heights connects to Bukit Merah, HarbourFront, the CBD and other parts of Singapore.",
      },
    ],
  },
  
];
---
<Layout
  title="Sitemap | Depot Heights, Bukit Merah Singapore"
  description="Explore the Depot Heights website sitemap and find information about the neighbourhood, history, amenities, sports and recreation, healthcare, schools, food, cafés, restaurants, parks, lifestyle, shopping, transport and property."
  canonical="https://depot-heights.pages.dev/sitemap"
>
  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">
          DEPOT HEIGHTS WEBSITE
        </p>

        <h1>
          Sitemap
          <span>Explore Depot Heights.</span>
        </h1>

        <p class="hero-text">
          Find your way around the Depot Heights website. Explore the
          neighbourhood's history, amenities, sports and recreation,
          healthcare, schools, food, cafés, restaurants, parks,
          lifestyle, shopping, transport and property information.
        </p>
      </div>

      <div class="hero-card">
        <div class="hero-card-inner">
          <p>
            DEPOT HEIGHTS
          </p>

          <div class="hero-card-line"></div>

          <strong>
            Your guide<br />
            to the neighbourhood.
          </strong>
        </div>
      </div>
    </section>

    <!-- SITEMAP -->
    <section class="sitemap-section">
      <div class="section-heading">
        <p class="eyebrow">
          WEBSITE DIRECTORY
        </p>

        <h2>
          Explore the website.
        </h2>

        <p>
          Browse the sections below to quickly find the information
          you are looking for.
        </p>
      </div>

      <div class="sitemap-grid">
        {
          sitemapSections.map((section) => (
            <section class="sitemap-group">
              <h2>
                {section.title}
              </h2>

              <div class="sitemap-links">
                {section.items.map((item) => (
                  <a
                    class="sitemap-card"
                    href={item.href}
                  >
                    <div class="sitemap-card-content">
                      <h3>
                        {item.name}
                      </h3>

                      <p>
                        {item.description}
                      </p>
                    </div>

                    <span
                      class="sitemap-arrow"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </a>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <!-- FEATURED SUMMARY -->
    <section class="featured">
      <div>
        <p class="eyebrow">
          DEPOT HEIGHTS
        </p>

        <h2>
          Discover more of the neighbourhood.
        </h2>
      </div>

      <p>
        From the history of Depot Heights and everyday estate
        amenities to local food, healthcare, schools, parks,
        transport and property information, explore the different
        parts of life at Depot Heights and around Bukit Merah.
      </p>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    min-width: 320px;
    color: #1d2924;
    background: #f7f5ef;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    line-height: 1.7;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    display: grid;
    grid-template-columns:
      minmax(0, 1.4fr)
      minmax(280px, 0.6fr);
    min-height: 62vh;
    padding: 7rem 8vw 6rem;
    gap: 5rem;
    align-items: center;
    background:
      radial-gradient(
        circle at 80% 30%,
        rgba(94, 145, 112, 0.22),
        transparent 35%
      ),
      linear-gradient(
        135deg,
        #eef3e9 0%,
        #f7f5ef 60%
      );
  }
  .hero-content {
    max-width: 850px;
  }
  .eyebrow {
    margin: 0 0 1rem;
    color: #3d805f;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size:
      clamp(48px, 8vw, 82px);
    line-height: 0.94;
    letter-spacing: -0.07em;
  }

  h1 span {
    display: block;
    color: #3d805f;
  }

  .hero-text {
    max-width: 720px;
    margin: 1.8rem 0 0;
    color: #53615b;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-card {
    position: relative;
    min-height: 360px;
    overflow: hidden;
    border-radius: 2rem;
    color: white;
    background:
      linear-gradient(
        145deg,
        #315f4a,
        #183d2d
      );

    box-shadow:
      0 25px 70px
      rgba(39, 102, 77, 0.18);
  }

  .hero-card::before {
    content: "";
    position: absolute;
    width: 260px;
    height: 260px;
    top: -70px;
    right: -70px;
    border-radius: 50%;
    border:
      1px solid
      rgba(255, 255, 255, 0.15);
  }

  .hero-card::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: 35px;
    bottom: -70px;
    border-radius: 50%;
    border:
      1px solid
      rgba(255, 255, 255, 0.12);
  }

  .hero-card-inner {
    position: absolute;
    z-index: 2;
    right: 2.5rem;
    bottom: 2.5rem;
    left: 2.5rem;
  }

  .hero-card-inner p {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .hero-card-line {
    width: 50px;
    height: 2px;
    margin: 1rem 0;
    background: white;
  }

  .hero-card strong {
    display: block;
    font-size:
      clamp(2rem, 4vw, 3.4rem);

    line-height: 1;
    letter-spacing: -0.05em;
  }

  .sitemap-section {
    padding: 8rem 8vw;
  }

  .section-heading {
    max-width: 850px;
    margin: 0 auto 5rem;
    text-align: center;
  }

  .section-heading h2 {
    margin: 0;
    font-size:
      clamp(38px, 5vw, 65px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .section-heading > p:last-child {
    max-width: 650px;
    margin: 1.5rem auto 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .sitemap-grid {
    max-width: 1100px;
    margin: 0 auto;
  }

  .sitemap-group {
    margin-bottom: 5rem;
  }

  .sitemap-group:last-child {
    margin-bottom: 0;
  }

  .sitemap-group > h2 {
    margin: 0 0 1.5rem;
    padding-bottom: 1rem;
    color: #27664d;
    border-bottom:
      2px solid
      #cbd5cd;
    font-size:
      clamp(28px, 3vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }

  .sitemap-links {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .sitemap-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 150px;
    padding: 1.75rem 2rem;
    border:
      1px solid
      #cbd5cd;
    border-radius: 1.25rem;
    background:
      rgba(255, 255, 255, 0.42);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .sitemap-card:hover {
    transform: translateY(-4px);
    border-color: #9eb3a5;
    background:
      rgba(255, 255, 255, 0.75);
    box-shadow:
      0 15px 35px
      rgba(39, 102, 77, 0.08);
  }

  .sitemap-card-content {
    min-width: 0;
  }

  .sitemap-card h3 {
    margin: 0;
    color: #27664d;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .sitemap-card p {
    margin: 0.7rem 0 0;
    color: #65736c;
    font-size: 15px;
    line-height: 1.65;
  }

  .sitemap-arrow {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: white;
    background: #27664d;
    font-size: 20px;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .sitemap-card:hover .sitemap-arrow {
    transform: translateX(3px);
    background: #1f513d;
  }

  .featured {
    display: grid;
    grid-template-columns:
      1.3fr 0.7fr;
    gap: 5rem;
    padding: 7rem 8vw;
    color: white;
    background: #27664d;
  }

  .featured h2 {
    margin: 0;
    font-size:
      clamp(38px, 5vw, 65px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .featured .eyebrow {
    color: #b9d7c1;
  }

  .featured p:last-child {
    align-self: end;
    margin: 0;
    color: #d5e5d9;
    font-size: 17px;
    line-height: 1.8;
  }

  @media (max-width: 900px) {
    .hero,
    .featured {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 5rem;
    }

    .hero-card {
      min-height: 280px;
    }

    .sitemap-links {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding:
        4rem 5vw;
    }

    .sitemap-section {
      padding:
        5rem 5vw;
    }

    .featured {
      padding-left: 5vw;
      padding-right: 5vw;
    }

    .sitemap-card {
      min-height: 130px;

      padding: 1.5rem;
    }

    .sitemap-card h3 {
      font-size: 21px;
    }

    .sitemap-card p {
      font-size: 14px;
    }

    .sitemap-arrow {
      width: 38px;
      height: 38px;
      font-size: 18px;
    }
  }
</style>