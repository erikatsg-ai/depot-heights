---
import Layout from "../layouts/Layout.astro";

const familyClinics = [
  {
    name: "New Health Family Clinic",
    location: "Depot Road",
    image: "/images/new-health-family-clinic.webp",
    description:
      "New Health Family Clinic provides convenient family and primary healthcare services for residents in the Depot Heights and surrounding neighbourhood.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=New+Health+Family+Clinic+Singapore",
  },
  {
    name: "Meridian Medical Centre",
    location: "Depot Heights Shopping Centre",
    image: "/images/meridian-medical-centre.webp",
    description:
      "Meridian Medical Centre @ Depot Heights Shopping Centre provides a convenient nearby option for residents seeking family and primary medical care close to home.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Meridian+Medical+Centre+Depot+Heights+Shopping+Centre+Singapore",
  },
];

const polyclinics = [
  {
    name: "Queenstown Polyclinic",
    location: "Queenstown",
    image: "/images/queenstown-polyclinic.webp",
    description:
      "Queenstown Polyclinic provides accessible public primary healthcare services for residents in the Queenstown area and surrounding neighbourhoods.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Queenstown+Polyclinic+Singapore",
  },
  {
    name: "Bukit Merah Polyclinic",
    location: "Bukit Merah",
    image: "/images/bukit-merah-polyclinic.webp",
    description:
      "Bukit Merah Polyclinic provides public primary healthcare services for residents in Bukit Merah and nearby communities.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Bukit+Merah+Polyclinic+Singapore",
  },
];

const publicHospitals = [
  {
    name: "Alexandra Hospital",
    location: "Alexandra Road",
    image: "/images/alexandra-hospital.webp",
    description:
      "Alexandra Hospital is one of the public hospitals serving residents in the western and central parts of Singapore. Its location along Alexandra Road makes it a convenient healthcare option from Depot Heights.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Alexandra+Hospital+Singapore",
  },
  {
    name: "Singapore General Hospital",
    location: "Outram Road",
    image: "/images/singapore-general-hospital.webp",
    description:
      "Singapore General Hospital is one of Singapore's major public hospitals and a key healthcare institution for specialist and tertiary medical care. It is accessible from Depot Heights by road and public transport.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Singapore+General+Hospital",
  },
  {
    name: "National University Hospital",
    location: "Lower Kent Ridge Road",
    image: "/images/national-university-hospital.webp",
    description:
      "National University Hospital is a major public hospital and academic medical centre in Singapore. Located in the Kent Ridge area, it provides a wide range of specialist and tertiary healthcare services.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=National+University+Hospital+Singapore",
  },
];

const privateHospitals = [
  {
    name: "Mount Elizabeth Hospital – Orchard",
    location: "Orchard Road",
    image: "/images/mount-elizabeth-hospital-orchard.webp",
    description:
      "Mount Elizabeth Hospital at Orchard is a well-known private hospital providing specialist medical care and a broad range of healthcare services. Its central Orchard location makes it accessible from Depot Heights.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Mount+Elizabeth+Hospital+Orchard+Singapore",
  },
  {
    name: "Gleneagles Hospital",
    location: "Napier Road",
    image: "/images/gleneagles-hospital.webp",
    description:
      "Gleneagles Hospital is a major private hospital located in the Orchard and Tanglin area. It provides a wide range of specialist healthcare services and is another private hospital option accessible from Depot Heights.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Gleneagles+Hospital+Singapore",
  },
];

const specialistCare = [
  {
    name: "Camden Medical Centre",
    location: "Orchard Boulevard",
    image: "/images/camden-medical-centre.webp",
    description:
      "Camden Medical Centre is a specialist medical centre offering access to a range of specialist doctors and medical practices. It is located in the Orchard medical district and provides another option for residents seeking specialist care beyond a hospital setting.",
    mapUrl:
      "https://www.google.com/maps/search/?api=1&query=Camden+Medical+Centre+Singapore",
  },
];
---

<Layout
  title="Healthcare Near Depot Heights | Hospitals, Clinics & Medical Centres"
  description="Explore healthcare options near Depot Heights, including nearby family clinics, Queenstown Polyclinic, Bukit Merah Polyclinic, Alexandra Hospital, Singapore General Hospital, National University Hospital, Mount Elizabeth Hospital, Gleneagles Hospital and Camden Medical Centre."
  canonical="https://depotheights.sg/healthcare"
  image="/images/healthcare-hero.webp"
>
  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">
          HEALTHCARE NEAR DEPOT HEIGHTS
        </p>

        <h1>
          Healthcare
          <span>close to home.</span>
        </h1>

        <p class="hero-text">
          Depot Heights residents have access to a wide range of
          healthcare options nearby, from convenient family clinics
          and public primary healthcare to major public and private
          hospitals and specialist medical care across Alexandra,
          Outram, Kent Ridge and Orchard.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#clinics">
            Nearby clinics
          </a>

          <a class="button secondary" href="#hospitals">
            Explore hospitals
          </a>
        </div>
      </div>

      <div class="hero-card">
        <img
          src="/images/healthcare-hero.webp"
          alt="Healthcare services and hospitals near Depot Heights"
        />

        <div class="hero-card-overlay">
          <p>DEPOT HEIGHTS</p>

          <div class="hero-card-line"></div>

          <strong>
            Healthcare.<br />
            Within reach.
          </strong>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro">
      <p class="eyebrow">
        HEALTHCARE AROUND DEPOT HEIGHTS
      </p>

      <h2>
        Medical care across the neighbourhood.
      </h2>

      <p>
        Living at Depot Heights means having access to healthcare
        options at different levels, from nearby family clinics and
        polyclinics for primary healthcare needs to specialist medical
        centres and major public and private hospitals providing more
        comprehensive care.
      </p>
    </section>

    <!-- FAMILY CLINICS -->
    <section class="content-section soft-section" id="clinics">
      <div class="section-heading">
        <p class="eyebrow">
          NEARBY FAMILY CLINICS
        </p>

        <h2>
          Convenient care close to Depot Heights.
        </h2>

        <p>
          For everyday healthcare needs, residents can visit nearby
          family clinics in the Depot Heights Shopping Centre.
        </p>
      </div>

      <div class="card-grid two-columns">
        {familyClinics.map((clinic) => (
          <article class="health-card">
            <div class="card-image">
              <img
                src={clinic.image}
                alt={`${clinic.name} near Depot Heights`}
                loading="lazy"
              />
            </div>

            <div class="card-content">
              <p class="card-location">
                {clinic.location}
              </p>

              <h3>
                {clinic.name}
              </h3>

              <p>
                {clinic.description}
              </p>

              <a
                class="map-button"
                href={clinic.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>📍</span>
                View on Google Maps
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- POLYCLINICS -->
    <section class="content-section">
      <div class="section-heading">
        <p class="eyebrow">
          NEARBY POLYCLINICS
        </p>

        <h2>
          Public primary healthcare nearby.
        </h2>

        <p>
          Residents can also access public primary healthcare services
          at Queenstown Polyclinic and Bukit Merah Polyclinic.
        </p>
      </div>

      <div class="card-grid two-columns">
        {polyclinics.map((polyclinic) => (
          <article class="health-card">
            <div class="card-image">
              <img
                src={polyclinic.image}
                alt={`${polyclinic.name} near Depot Heights`}
                loading="lazy"
              />
            </div>

            <div class="card-content">
              <p class="card-location">
                {polyclinic.location}
              </p>

              <h3>
                {polyclinic.name}
              </h3>

              <p>
                {polyclinic.description}
              </p>

              <a
                class="map-button"
                href={polyclinic.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>📍</span>
                View on Google Maps
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- PUBLIC HOSPITALS -->
    <section class="content-section soft-section" id="hospitals">
      <div class="section-heading">
        <p class="eyebrow">
          PUBLIC HOSPITALS
        </p>

        <h2>
          Major public hospitals nearby.
        </h2>

        <p>
          Depot Heights is within reach of several major public
          hospitals serving the wider Alexandra, Outram and Kent Ridge
          areas.
        </p>
      </div>

      <div class="card-grid three-columns">
        {publicHospitals.map((hospital) => (
          <article class="health-card">
            <div class="card-image">
              <img
                src={hospital.image}
                alt={`${hospital.name} near Depot Heights`}
                loading="lazy"
              />
            </div>

            <div class="card-content">
              <p class="card-location">
                {hospital.location}
              </p>

              <h3>
                {hospital.name}
              </h3>

              <p>
                {hospital.description}
              </p>

              <a
                class="map-button"
                href={hospital.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>📍</span>
                View on Google Maps
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- PRIVATE HOSPITALS -->
    <section class="content-section">
      <div class="section-heading">
        <p class="eyebrow">
          PRIVATE HOSPITALS
        </p>

        <h2>
          Private hospital options.
        </h2>

        <p>
          Residents can also access established private hospitals in
          the Orchard and Tanglin medical district.
        </p>
      </div>

      <div class="card-grid two-columns">
        {privateHospitals.map((hospital) => (
          <article class="health-card">
            <div class="card-image">
              <img
                src={hospital.image}
                alt={`${hospital.name} private hospital`}
                loading="lazy"
              />
            </div>

            <div class="card-content">
              <p class="card-location">
                {hospital.location}
              </p>

              <h3>
                {hospital.name}
              </h3>

              <p>
                {hospital.description}
              </p>

              <a
                class="map-button"
                href={hospital.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>📍</span>
                View on Google Maps
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- SPECIALIST CARE -->
    <section class="content-section soft-section">
      <div class="section-heading">
        <p class="eyebrow">
          SPECIALIST CARE
        </p>

        <h2>
          Specialist care beyond the hospital.
        </h2>

        <p>
          For residents looking for specialist medical services in a
          dedicated medical centre setting, Camden Medical Centre is
          located in the Orchard medical district.
        </p>
      </div>

      <div class="card-grid one-column specialist-grid">
        {specialistCare.map((centre) => (
          <article class="health-card specialist-card">
            <div class="card-image">
              <img
                src={centre.image}
                alt={`${centre.name} specialist medical centre`}
                loading="lazy"
              />
            </div>

            <div class="card-content">
              <p class="card-location">
                {centre.location}
              </p>

              <h3>
                {centre.name}
              </h3>

              <p>
                {centre.description}
              </p>

              <a
                class="map-button"
                href={centre.mapUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span>📍</span>
                View on Google Maps
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- FEATURED SUMMARY -->
    <section class="featured">
      <div>
        <p class="eyebrow">
          HEALTHCARE AT DEPOT HEIGHTS
        </p>

        <h2>
          Everyday care and major medical services are within reach.
        </h2>
      </div>

      <p>
        From New Health Family Clinic and Meridian Medical Centre
        @ Depot Heights Shopping Centre for convenient family care,
        to nearby polyclinics, major public and private hospitals and
        Camden Medical Centre for specialist services, Depot Heights
        residents have a broad range of healthcare options nearby.
      </p>
    </section>

    <!-- RELATED -->
    <section class="related-section">
      <div class="related-heading">
        <p class="eyebrow">
          LIVING AROUND DEPOT HEIGHTS
        </p>

        <h2>
          Explore more of the neighbourhood.
        </h2>
      </div>

      <div class="related-grid">
        <article class="related-card">
          <h3>
            Amenities
          </h3>

          <p>
            Discover the everyday amenities and services available
            around Depot Heights.
          </p>

          <a
            class="text-link"
            href="/amenities"
          >
            Explore Amenities →
          </a>
        </article>

        <article class="related-card">
          <h3>
            Transport
          </h3>

          <p>
            Find out how Depot Heights connects to Bukit Merah,
            HarbourFront, the CBD and other parts of Singapore.
          </p>

          <a
            class="text-link"
            href="/transport"
          >
            Explore Transport →
          </a>
        </article>

        <article class="related-card">
          <h3>
            Lifestyle & Nature
          </h3>

          <p>
            Explore parks, heritage sites, cafés, arts, shopping and
            leisure destinations around Depot Heights.
          </p>

          <a
            class="text-link"
            href="/living-around-depot-heights"
          >
            Explore Lifestyle & Nature →
          </a>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;

    color: #1d2924;

    background: #f7f5ef;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    display: grid;

    grid-template-columns:
      minmax(0, 1.5fr)
      minmax(280px, 0.7fr);

    min-height: 78vh;

    padding: 8rem 8vw 6rem;

    gap: 5rem;

    align-items: center;

    background:
      radial-gradient(
        circle at 80% 30%,
        rgba(94, 145, 112, 0.22),
        transparent 35%
      ),
      linear-gradient(
        135deg,
        #eef3e9 0%,
        #f7f5ef 60%
      );
  }

  .hero-content {
    max-width: 850px;
  }

  .eyebrow {
    margin: 0 0 1rem;

    color: #3d805f;

    font-size: 14px;
    font-weight: 800;

    letter-spacing: 0.18em;
  }

  h1 {
    max-width: 900px;

    margin: 0;

    font-size:
      clamp(45px, 8vw, 80px);

    line-height: 0.94;

    letter-spacing: -0.07em;
  }

  h1 span {
    display: block;

    color: #3d805f;
  }

  .hero-text {
    max-width: 700px;

    margin: 1.8rem 0 0;

    color: #53615b;

    font-size: 18px;

    line-height: 1.8;
  }

  .hero-actions {
    display: flex;

    flex-wrap: wrap;

    gap: 0.8rem;

    margin-top: 2rem;
  }

  .button {
    padding: 0.9rem 1.25rem;

    border-radius: 999px;

    font-size: 0.85rem;

    font-weight: 750;
  }

  .primary {
    color: white;

    background: #27664d;
  }

  .secondary {
    color: #27664d;

    border:
      1px solid
      #9eb3a5;
  }

  .hero-card {
    position: relative;

    min-height: 360px;

    overflow: hidden;

    border-radius: 2rem;

    color: white;

    background: #315f4a;

    box-shadow:
      0 25px 70px
      rgba(39, 102, 77, 0.18);
  }

  .hero-card img {
    display: block;

    width: 100%;
    height: 100%;

    min-height: 360px;

    object-fit: cover;
  }

  .hero-card::after {
    content: "";

    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        to bottom,
        rgba(31, 72, 55, 0.05),
        rgba(31, 72, 55, 0.9)
      );
  }

  .hero-card-overlay {
    position: absolute;

    z-index: 2;

    right: 2rem;
    bottom: 2rem;
    left: 2rem;
  }

  .hero-card-overlay p {
    margin: 0;

    font-size: 0.7rem;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  .hero-card-line {
    width: 50px;
    height: 2px;

    margin: 1rem 0;

    background: white;
  }

  .hero-card strong {
    display: block;

    font-size:
      clamp(1.8rem, 3vw, 3rem);

    line-height: 1;

    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 850px;

    margin: 0 auto;

    padding: 8rem 8vw 4rem;

    text-align: center;
  }

  .intro h2,
  .featured h2,
  .related-heading h2 {
    margin: 0;

    font-size:
      clamp(38px, 5vw, 65px);

    line-height: 1;

    letter-spacing: -0.06em;
  }

  .intro > p:last-child {
    margin: 1.5rem auto 0;

    color: #65736c;

    font-size: 17px;

    line-height: 1.7;
  }

  .content-section {
    padding: 5rem 8vw 8rem;
  }

  .soft-section {
    background: #e9eee7;
  }

  .section-heading {
    max-width: 850px;

    margin: 0 auto 3.5rem;

    text-align: center;
  }

  .section-heading h2 {
    margin: 0;

    font-size:
      clamp(38px, 5vw, 65px);

    line-height: 1;

    letter-spacing: -0.06em;
  }

  .section-heading > p:last-child {
    max-width: 700px;

    margin: 1.5rem auto 0;

    color: #65736c;

    font-size: 17px;

    line-height: 1.8;
  }

  .card-grid {
    display: grid;

    gap: 1.5rem;

    max-width: 1100px;

    margin: 0 auto;
  }

  .three-columns {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

  .two-columns {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .one-column {
    grid-template-columns: 1fr;
  }

  .specialist-grid {
    max-width: 700px;
  }

  .health-card {
    overflow: hidden;

    border:
      1px solid
      #cbd5cd;

    border-radius: 1.5rem;

    background:
      rgba(255, 255, 255, 0.42);

    box-shadow:
      0 12px 35px
      rgba(39, 102, 77, 0.05);
  }

  .card-image {
    overflow: hidden;
  }

  .card-image img {
    display: block;

    width: 100%;
    height: 270px;

    object-fit: cover;

    transition:
      transform 0.35s ease;
  }

  .health-card:hover .card-image img {
    transform: scale(1.03);
  }

  .card-content {
    padding: 2rem;
  }

  .card-location {
    margin: 0 0 0.6rem;

    color: #3d805f;

    font-size: 14px;

    font-weight: 800;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }

  .health-card h3 {
    margin: 0;

    color: #27664d;

    font-size:
      clamp(23px, 2.2vw, 28px);

    line-height: 1.15;

    letter-spacing: -0.03em;
  }

  .health-card p:not(.card-location) {
    margin: 1rem 0 1.5rem;

    color: #65736c;

    font-size: 16px;

    line-height: 1.75;
  }

  .map-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 0.5rem;

    min-height: 50px;

    padding: 0.9rem 1.2rem;

    border-radius: 1rem;

    color: white;

    background: #27664d;

    font-size: 0.82rem;

    font-weight: 750;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .map-button:hover {
    background: #1f513d;

    transform: translateY(-2px);
  }

  .featured {
    display: grid;

    grid-template-columns:
      1.3fr 0.7fr;

    gap: 5rem;

    padding: 7rem 8vw;

    color: white;

    background: #27664d;
  }

  .featured .eyebrow {
    color: #b9d7c1;
  }

  .featured p:last-child {
    align-self: end;

    margin: 0;

    color: #d5e5d9;

    font-size: 17px;

    line-height: 1.8;
  }

  .related-section {
    padding: 8rem 8vw;
  }

  .related-heading {
    max-width: 850px;

    margin: 0 auto 3rem;

    text-align: center;
  }

  .related-grid {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    gap: 1.5rem;

    max-width: 1100px;

    margin: 0 auto;
  }

  .related-card {
    padding: 2rem;

    border:
      1px solid
      #cbd5cd;

    border-radius: 1.5rem;

    background:
      rgba(255, 255, 255, 0.28);
  }

  .related-card h3 {
    margin: 0;

    color: #27664d;

    font-size: 24px;
  }

  .related-card p {
    margin: 1rem 0 1.5rem;

    color: #65736c;

    font-size: 16px;

    line-height: 1.7;
  }

  .text-link {
    color: #27664d;

    font-size: 0.85rem;

    font-weight: 800;
  }

  .text-link:hover {
    color: #1f513d;
  }

  @media (max-width: 1000px) {
    .three-columns {
      grid-template-columns: 1fr;
    }

    .two-columns {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .hero,
    .featured {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 5rem;
    }

    .hero-card {
      min-height: 280px;
    }

    .hero-card img {
      min-height: 280px;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .two-columns {
      grid-template-columns: 1fr;
    }

    .hero {
      padding:
        4rem 5vw;
    }

    .content-section,
    .intro,
    .related-section {
      padding-left: 5vw;
      padding-right: 5vw;
    }

    .featured {
      padding-left: 5vw;
      padding-right: 5vw;
    }

    .card-content {
