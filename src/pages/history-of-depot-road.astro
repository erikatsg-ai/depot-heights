---
import Layout from "../layouts/Layout.astro";

const pageTitle =
  "History of Depot Heights | From Gillman Barracks to Today";

const pageDescription =
  "Discover the history around Depot Heights, from the British military presence at Gillman Barracks and its 1930s history to the development of Depot Road and the neighbourhood today.";

const heroImage = "/images/gillman-barracks.webp";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/history-of-depot-heights"
  image={heroImage}
  imageAlt="Historic Gillman Barracks near Depot Heights"
>
  <main>
    <!-- HERO -->

    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">
          HISTORY OF DEPOT HEIGHTS
        </p>

        <h1>
          From military history
          <span>to neighbourhood life.</span>
        </h1>

        <p class="hero-text">
          The area around Depot Heights has a history that reaches
          back well before today's HDB blocks and neighbourhood
          amenities. Its story is connected to the former British
          military presence at Gillman Barracks, the development of
          Depot Road and the transformation of Singapore's southern
          districts over the decades.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#history">
            Explore the history
          </a>

          <a class="button secondary" href="/about-depot-heights">
            About Depot Heights
          </a>
        </div>
      </div>

      <div class="hero-card">
        <img
          src={heroImage}
          alt="Historic Gillman Barracks near Depot Heights"
        />

        <div class="hero-card-overlay">
          <p>DEPOT HEIGHTS</p>

          <div class="hero-card-line"></div>

          <strong>
            A neighbourhood<br />
            shaped by history.
          </strong>
        </div>
      </div>
    </section>

    <!-- INTRODUCTION -->

    <section class="intro" id="history">
      <p class="eyebrow">
        A LOOK INTO THE PAST
      </p>

      <h2>
        The story behind the neighbourhood.
      </h2>

      <p>
        Today, Depot Heights is a residential neighbourhood in
        Bukit Merah, surrounded by established communities, parks,
        food destinations and everyday amenities. But the wider area
        has a much longer story.
      </p>

      <p>
        To understand the history around Depot Heights, it is useful
        to look beyond the residential blocks themselves and explore
        the surrounding military, industrial and residential
        development that shaped this part of Singapore.
      </p>
    </section>

    <!-- GILLMAN BARRACKS -->

    <section class="history-section">
      <div class="history-grid">
        <div class="history-image">
          <img
            src="/images/gillman-barracks-1937.webp"
            alt="Gillman Barracks in 1937"
            loading="lazy"
          />
        </div>

        <div class="history-content">
          <p class="eyebrow">
            GILLMAN BARRACKS
          </p>

          <h2>
            A British military presence in Singapore.
          </h2>

          <p>
            One of the most important historical landmarks in the
            wider area is Gillman Barracks. The former military
            complex reflects Singapore's colonial and military past
            and forms an important part of the history of the
            surrounding Alexandra and southern Singapore area.
          </p>

          <p>
            During the British period, military facilities occupied
            significant areas of Singapore. Gillman Barracks was part
            of this wider military landscape, serving as a reminder
            of the strategic importance of the island and its role
            within the British Empire.
          </p>

          <p>
            Historical photographs from the 1930s provide a glimpse
            into how the area looked during this period, long before
            the modern residential neighbourhoods that surround it
            today.
          </p>
        </div>
      </div>
    </section>

    <!-- ARCHIVAL IMAGE -->

    <section class="archival-section">
      <div class="archival-inner">
        <div class="archival-heading">
          <p class="eyebrow">
            ARCHIVAL HISTORY
          </p>

          <h2>
            A landscape very different from today.
          </h2>

          <p>
            The historic landscape around Gillman Barracks was very
            different from the residential and commercial districts
            familiar to residents today. Archival photographs help
            connect the present neighbourhood with the earlier
            history of the area.
          </p>
        </div>

        <div class="archival-image">
          <img
            src="/images/gillman-barracks-archival.webp"
            alt="Archival photograph of Gillman Barracks"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- DEPOT ROAD -->

    <section class="history-section alternate">
      <div class="history-grid reverse">
        <div class="history-content">
          <p class="eyebrow">
            DEPOT ROAD
          </p>

          <h2>
            From military surroundings to a growing neighbourhood.
          </h2>

          <p>
            As Singapore developed, the areas around Depot Road,
            Alexandra and Bukit Merah gradually changed. Land that
            had once been associated with military and other
            historical uses became part of a much larger urban
            landscape.
          </p>

          <p>
            Roads, housing estates, schools, transport links and
            neighbourhood amenities gradually transformed the
            southern part of Singapore. Depot Road became part of
            this changing landscape, linking the area with the wider
            Bukit Merah and Alexandra districts.
          </p>

          <p>
            The neighbourhood that residents know today is therefore
            the result of many layers of Singapore's development,
            from its colonial history through the growth of public
            housing and modern urban life.
          </p>
        </div>

        <div class="history-image">
          <img
            src="/images/gillman-barracks.webp"
            alt="Historic view connected to the Gillman Barracks area"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- TRANSFORMATION -->

    <section class="transformation-section">
      <div class="transformation-heading">
        <p class="eyebrow">
          A CHANGING SINGAPORE
        </p>

        <h2>
          The wider area continued to evolve.
        </h2>

        <p>
          Singapore's southern districts experienced significant
          change as the city expanded and modernised. Former military
          sites, industrial areas and older neighbourhoods became
          part of a more connected urban environment.
        </p>
      </div>

      <div class="transformation-grid">
        <article class="history-card">
          <span class="card-number">
            01
          </span>

          <h3>
            Military heritage
          </h3>

          <p>
            The former Gillman Barracks remains an important reminder
            of Singapore's colonial and military history.
          </p>
        </article>

        <article class="history-card">
          <span class="card-number">
            02
          </span>

          <h3>
            Urban development
          </h3>

          <p>
            The wider Alexandra, Bukit Merah and Depot Road areas
            developed alongside Singapore's growth as a modern city.
          </p>
        </article>

        <article class="history-card">
          <span class="card-number">
            03
          </span>

          <h3>
            Neighbourhood life
          </h3>

          <p>
            Today, Depot Heights is part of an established residential
            community surrounded by food, transport, healthcare,
            schools, parks and everyday conveniences.
          </p>
        </article>
      </div>
    </section>

    <!-- DEPOT HEIGHTS TODAY -->

    <section class="today-section">
      <div class="today-grid">
        <div>
          <p class="eyebrow">
            DEPOT HEIGHTS TODAY
          </p>

          <h2>
            History remains part of the neighbourhood.
          </h2>
        </div>

        <div class="today-content">
          <p>
            Living at Depot Heights today means being part of a
            neighbourhood surrounded by layers of Singapore's past
            and present.
          </p>

          <p>
            The area combines established HDB housing with access to
            local food, shopping, healthcare, schools, transport and
            green spaces. At the same time, nearby historical places
            such as Gillman Barracks provide a connection to the
            area's earlier identity.
          </p>

          <p>
            This combination of history, residential life and modern
            convenience is part of what makes the wider Depot Heights
            neighbourhood distinctive.
          </p>
        </div>
      </div>
    </section>

    <!-- HISTORICAL PHOTO -->

    <section class="photo-feature">
      <div class="photo-feature-image">
        <img
          src="/images/gillman-barracks-archival.webp"
          alt="Historic archival view of Gillman Barracks"
          loading="lazy"
        />
      </div>

      <div class="photo-feature-content">
        <p class="eyebrow">
          REMEMBERING THE PAST
        </p>

        <h2>
          The neighbourhood has changed, but its history remains.
        </h2>

        <p>
          Historical photographs offer a window into an earlier
          Singapore and help us appreciate how dramatically the
          landscape around Depot Heights has evolved.
        </p>
      </div>
    </section>

    <!-- RELATED -->

    <section class="related-section">
      <div class="related-heading">
        <p class="eyebrow">
          EXPLORE DEPOT HEIGHTS
        </p>

        <h2>
          Continue discovering the neighbourhood.
        </h2>
      </div>

      <div class="related-grid">
        <article class="related-card">
          <h3>
            About Depot Heights
          </h3>

          <p>
            Learn more about Depot Heights, its residential blocks
            and the neighbourhood community.
          </p>

          <a
            class="text-link"
            href="/about-depot-heights"
          >
            Explore About Depot Heights →
          </a>
        </article>

        <article class="related-card">
          <h3>
            Lifestyle & Nature
          </h3>

          <p>
            Discover parks, heritage sites, nature trails, arts,
            leisure and other destinations around the neighbourhood.
          </p>

          <a
            class="text-link"
            href="/living-around-depot-heights"
          >
            Explore Lifestyle & Nature →
          </a>
        </article>

        <article class="related-card">
          <h3>
            Depot Heights Location
          </h3>

          <p>
            Explore the neighbourhood's location and its connections
            to Bukit Merah, Alexandra and the wider Singapore area.
          </p>

          <a
            class="text-link"
            href="/location"
          >
            Explore Location →
          </a>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  .hero {
    display: grid;
    grid-template-columns:
      minmax(0, 1.25fr)
      minmax(320px, 0.75fr);
    gap: 70px;
    align-items: center;
    min-height: 720px;
    padding: 90px 5vw;
    background:
      radial-gradient(
        circle at 82% 28%,
        rgba(102, 151, 119, 0.18),
        transparent 34%
      ),
      linear-gradient(
        135deg,
        #edf3ea 0%,
        #f7f8f3 65%
      );
  }

  .hero-content {
    width: min(900px, 100%);
  }

  .eyebrow {
    margin: 0 0 18px;
    color: #3f805f;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1.4;
  }

  .hero h1 {
    max-width: 900px;
    margin: 0;
    color: #183126;
    font-size: clamp(45px, 7vw, 80px);
    font-weight: 750;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .hero h1 span {
    display: block;
    color: #3f805f;
  }

  .hero-text {
    max-width: 720px;
    margin: 28px 0 0;
    color: #607068;
    font-size: 18px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 13px 22px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 750;
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button.primary {
    color: #ffffff;
    background: #2b6e52;
  }

  .button.primary:hover {
    background: #235c45;
  }

  .button.secondary {
    color: #2b6e52;
    border: 1px solid #a9bdb0;
    background: rgba(255, 255, 255, 0.35);
  }

  .button.secondary:hover {
    background: #ffffff;
  }

  .hero-card {
    position: relative;
    min-height: 500px;
    overflow: hidden;
    border-radius: 30px;
    background: #315e49;
    box-shadow:
      0 25px 70px
      rgba(24, 49, 38, 0.14);
  }

  .hero-card img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 500px;
    object-fit: cover;
  }

  .hero-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(13, 33, 25, 0.02),
        rgba(13, 33, 25, 0.84)
      );
  }

  .hero-card-overlay {
    position: absolute;
    right: 32px;
    bottom: 32px;
    left: 32px;
    z-index: 2;
    color: #ffffff;
  }

  .hero-card-overlay p {
    margin: 0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .hero-card-line {
    width: 52px;
    height: 2px;
    margin: 16px 0;
    background: #ffffff;
  }

  .hero-card-overlay strong {
    display: block;
    font-size: clamp(28px, 4vw, 46px);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 900px;
    margin: 0 auto;
    padding: 120px 5vw 70px;
    text-align: center;
  }

  .intro h2,
  .archival-heading h2,
  .transformation-heading h2,
  .today-grid h2,
  .related-heading h2,
  .photo-feature-content h2 {
    margin: 0;
    color: #183126;
    font-size: clamp(38px, 5vw, 65px);
    font-weight: 750;
    letter-spacing: -0.06em;
    line-height: 1.02;
  }

  .intro > p:not(.eyebrow) {
    max-width: 760px;
    margin: 25px auto 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .intro > p + p {
    margin-top: 18px;
  }

  .history-section {
    padding: 70px 5vw 120px;
  }

  .history-section.alternate {
    background: #eef2ec;
  }

  .history-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);
    gap: 70px;
    align-items: center;
    width: min(1400px, 90vw);
    margin: 0 auto;
  }

  .history-grid.reverse {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 1fr);
  }

  .history-grid.reverse .history-content {
    order: 1;
  }

  .history-grid.reverse .history-image {
    order: 2;
  }

  .history-image {
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid rgba(24, 49, 38, 0.1);
    background: #e4ebe4;
  }

  .history-image img {
    display: block;
    width: 100%;
    min-height: 500px;
    object-fit: cover;
  }

  .history-content {
    max-width: 680px;
  }

  .history-content h2 {
    margin: 0;
    color: #183126;
    font-size: clamp(38px, 5vw, 65px);
    font-weight: 750;
    letter-spacing: -0.06em;
    line-height: 1.02;
  }

  .history-content p:not(.eyebrow) {
    margin: 22px 0 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .archival-section {
    padding: 120px 5vw;
    background: #f7f8f3;
  }

  .archival-inner {
    width: min(1200px, 90vw);
    margin: 0 auto;
  }

  .archival-heading {
    max-width: 850px;
    margin-bottom: 50px;
  }

  .archival-heading > p:last-child {
    max-width: 720px;
    margin: 24px 0 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .archival-image {
    overflow: hidden;
    border-radius: 30px;
    border: 1px solid rgba(24, 49, 38, 0.1);
    background: #e5ebe5;
  }

  .archival-image img {
    display: block;
    width: 100%;
    max-height: 650px;
    object-fit: cover;
  }

  .transformation-section {
    padding: 120px 5vw;
    background: #e9efe8;
  }

  .transformation-heading {
    width: min(900px, 90vw);
    margin: 0 auto 60px;
    text-align: center;
  }

  .transformation-heading > p:last-child {
    max-width: 720px;
    margin: 25px auto 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .transformation-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 22px;
    width: min(1200px, 90vw);
    margin: 0 auto;
  }

  .history-card {
    padding: 34px;
    border: 1px solid #cbd7ce;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.42);
  }

  .card-number {
    display: block;
    margin-bottom: 28px;
    color: #70a281;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .history-card h3 {
    margin: 0;
    color: #2b6e52;
    font-size: 26px;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .history-card p {
    margin: 16px 0 0;
    color: #65736c;
    font-size: 16px;
    line-height: 1.75;
  }

  .today-section {
    padding: 120px 5vw;
    color: #ffffff;
    background: #2b6e52;
  }

  .today-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(0, 0.85fr);
    gap: 80px;
    align-items: start;
    width: min(1200px, 90vw);
    margin: 0 auto;
  }

  .today-grid .eyebrow {
    color: #b9d7c1;
  }

  .today-grid h2 {
    color: #ffffff;
  }

  .today-content {
    align-self: end;
  }

  .today-content p {
    margin: 0;
    color: #d7e8dc;
    font-size: 17px;
    line-height: 1.8;
  }

  .today-content p + p {
    margin-top: 20px;
  }

  .photo-feature {
    display: grid;
    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(0, 0.9fr);
    gap: 70px;
    align-items: center;
    padding: 120px 5vw;
    background: #f7f8f3;
  }

  .photo-feature-image {
    overflow: hidden;
    border-radius: 30px;
    border: 1px solid rgba(24, 49, 38, 0.1);
  }

  .photo-feature-image img {
    display: block;
    width: 100%;
    min-height: 500px;
    object-fit: cover;
  }

  .photo-feature-content {
    max-width: 620px;
  }

  .photo-feature-content p:not(.eyebrow) {
    margin: 25px 0 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .related-section {
    padding: 120px 5vw;
    background: #eef2ec;
  }

  .related-heading {
    width: min(900px, 90vw);
    margin: 0 auto 55px;
    text-align: center;
  }

  .related-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 22px;
    width: min(1200px, 90vw);
    margin: 0 auto;
  }

  .related-card {
    padding: 34px;
    border: 1px solid #cbd7ce;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.42);
  }

  .related-card h3 {
    margin: 0;
    color: #2b6e52;
    font-size: 26px;
    letter-spacing: -0.04em;
  }

  .related-card p {
    margin: 16px 0 24px;
    color: #65736c;
    font-size: 16px;
    line-height: 1.75;
  }

  .text-link {
    color: #2b6e52;
    font-size: 15px;
    font-weight: 800;
  }

  .text-link:hover {
    color: #1f513d;
  }

  @media (max-width: 1000px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 70px;
    }

    .hero-card {
      min-height: 420px;
    }

    .hero-card img {
      min-height: 420px;
    }

    .history-grid,
    .history-grid.reverse,
    .photo-feature,
    .today-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .history-grid.reverse .history-content,
    .history-grid.reverse .history-image {
      order: initial;
    }

    .transformation-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .history-image img,
    .photo-feature-image img {
      min-height: 400px;
    }
  }

  @media (max-width: 700px) {
    .hero {
      padding: 60px 5vw;
    }

    .hero-card {
      min-height: 360px;
      border-radius: 24px;
    }

    .hero-card img {
      min-height: 360px;
    }

    .hero-card-overlay {
      right: 24px;
      bottom: 24px;
      left: 24px;
    }

    .intro,
    .archival-section,
    .history-section,
    .transformation-section,
    .today-section,
    .photo-feature,
    .related-section {
      padding-top: 80px;
      padding-bottom: 80px;
    }

    .history-grid {
      width: 90vw;
    }

    .archival-inner,
    .transformation-heading,
    .transformation-grid,
    .today-grid,
    .related-heading,
    .related-grid {
      width: 90vw;
    }

    .history-image img,
    .photo-feature-image img {
      min-height: 300px;
    }

    .history-card,
    .related-card {
      padding: 28px;
    }
  }

  @media (max-width: 500px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .button {
      width: 100%;
    }

    .hero-card-overlay strong {
      font-size: 30px;
    }
  }
</style>