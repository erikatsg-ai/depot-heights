---
import Layout from "../layouts/Layout.astro";
import ImageGallery from "../components/ImageGallery.astro";

const pageTitle =
  "Best Restaurants Near Depot Heights | Alexandra, Bukit Merah & Tiong Bahru Dining Guide";

const pageDescription =
  "Explore recommended restaurants near Depot Heights, including dining options around Alexandra, Anchorpoint, Tiong Bahru, Pasir Panjang, Telok Blangah Hill and Tanjong Pagar. Discover Japanese, Taiwanese, Italian, Western, Swedish and heritage dining options.";

const canonicalUrl = "https://depot-heights.pages.dev/restaurants";

const heroImage = "/images/depot-heights-hero.webp";

const restaurantEstates = [
  {
    estate: "Mount Faber & HortPark",
    restaurants: [
      {
        number: "01",
        id: "wineyard",
        name: "Wineyard",
        location: "HortPark",
        image: "/images/rs-wineyard.webp",
        alt: "Wineyard at HortPark near Depot Heights",
        description:
          "Wineyard is a garden dining destination around HortPark, offering a peaceful setting surrounded by greenery. It is an option to consider for a relaxed meal, brunch or weekend gathering.",
        highlight:
          "A convenient dining choice to combine with a visit to HortPark and the wider Southern Ridges area.",
        gallery: [
          "/images/rs-vineyard-menu.webp",
          "/images/rs-vineyard-carte-buffet.webp",
        ],
      },
      {
        number: "02",
        id: "alkaff-mansion",
        name: "The Alkaff Mansion",
        location: "Telok Blangah Hill",
        image: "/images/rs-alkaff-mansion-main.webp",
        alt: "The Alkaff Mansion on Telok Blangah Hill",
        description:
          "The Alkaff Mansion is a historic landmark on Telok Blangah Hill, surrounded by greenery and connected to the wider Southern Ridges. Today, the heritage mansion is also a distinctive dining destination, bringing together The Alkaff Mansion 1918 Heritage Bar and UNA Restaurant, known for its Spanish dining experience.",
        highlight:
          "A special destination close to Depot Heights for residents looking to combine heritage, greenery and dining.",
        gallery: [
          "/images/rs-alkaff-mansion-heritage.webp",
          "/images/rs-alkaff-mansion-food.webp",
        ],
      },
    ],
  },
  {
    estate: "Alexandra & Pasir Panjang",
    restaurants: [
      {
        number: "03",
        id: "verandah-rotisserie",
        name: "The Verandah Rotisserie",
        location: "Pasir Panjang",
        image: "/images/rs-verandah-rotisserie.webp",
        alt: "The Verandah Rotisserie at Pasir Panjang",
        description:
          "The Verandah Rotisserie is a Western dining option around Pasir Panjang, known for rotisserie-style dishes and hearty meals.",
        highlight:
          "A restaurant option to consider for a relaxed meal with family or friends.",
        gallery: [
          "/images/rs-verandah-rotisserie-rice.webp",
          "/images/rs-verandah-rotisserie-christmas.webp",
        ],
      },
      {
        number: "04",
        id: "eat3bowl",
        name: "Eat 3 Bowls",
        location: "Pasir Panjang",
        image: "/images/eat-3-bowls-storefront.webp",
        alt: "Eat 3 Bowls in Pasir Panjang",
        description:
          "Eat 3 Bowls is a Taiwanese food destination around Pasir Panjang, offering another nearby neighbourhood option for residents exploring food beyond Depot Heights.",
        highlight:
          "Pasir Panjang is also convenient to combine with visits to nearby parks, HortPark and other Southern Ridges destinations.",
        gallery: [
          "/images/eat-3-bowls-salted-chicken.webp",
          "/images/eat-3-bowls-garlic-steak.webp",
        ],
      },
      {
        number: "05",
        id: "ikea-alexandra",
        name: "IKEA Alexandra",
        location: "Alexandra Road",
        image: "/images/rs-ikea-alexandra.webp",
        alt: "IKEA Alexandra restaurant and bistro",
        description:
          "IKEA Alexandra is a popular destination along Alexandra Road. Besides furniture and home furnishing, its Swedish-style restaurant and bistro are familiar casual dining options, including its popular chicken wings.",
        highlight:
          "A convenient option when combining shopping, home furnishing errands and a casual meal around Alexandra.",
        gallery: [
          "/images/rs-ikea-alexandra-food.webp",
          "/images/rs-ikea-alexandra-chicken-wings.webp",
        ],
      },
      {
        number: "06",
        id: "sakuraya-anchorpoint",
        name: "Sakuraya",
        location: "Anchorpoint",
        image: "/images/sakuraya-store-front.webp",
        alt: "Sakuraya at Anchorpoint",
        description:
          "Sakuraya at Anchorpoint is a convenient Japanese dining option near Alexandra Road and within easy reach of Depot Heights.",
        highlight:
          "A practical choice for residents looking for Japanese food around the Alexandra area.",
        gallery: [
          "/images/sakuraya-sashimi.webp",
          "/images/sakuraya-grill-fish.webp",
        ],
      },
      {
        number: "07",
        id: "ma-maison",
        name: "Ma Maison",
        location: "Anchorpoint",
        image: "/images/ma-maison-storefront.webp",
        alt: "Ma Maison at Anchorpoint",
        description:
          "Ma Maison at Anchorpoint is another Japanese restaurant option around Alexandra Road, conveniently located for residents in the Depot Heights and Alexandra neighbourhoods.",
        highlight:
          "Its Anchorpoint location makes it easy to combine dining with shopping and errands around Alexandra.",
        gallery: [
          "/images/ma-maison-steak.webp",
          "/images/ma-maison-curry-egg.webp",
        ],
      },
    ],
  },
  {
    estate: "Tiong Bahru & Tanjong Pagar",
    restaurants: [
      {
        number: "08",
        id: "forketta",
        name: "Forketta",
        location: "Tiong Bahru",
        image: "/images/rs-forketta-tiongbahru.webp",
        alt: "Forketta in Tiong Bahru",
        description:
          "Located in the Tiong Bahru area, Forketta is part of a neighbourhood dining scene that combines restaurants, cafés, bakeries and traditional local food.",
        highlight:
          "Tiong Bahru is easy to combine with a wider food trip, café visit or walk around the neighbourhood.",
        gallery: [
          "/images/rs-forketta.webp",
          "/images/rs-forketta-pizza.webp",
        ],
      },
      {
        number: "09",
        id: "keisuke-tori-king",
        name: "Keisuke Tori King",
        location: "100AM, Tanjong Pagar",
        image: "/images/keisuke-tori-king-100am.webp",
        alt: "Keisuke Tori King at 100AM Tanjong Pagar",
        description:
          "Keisuke Tori King at 100AM is a Japanese dining option in Tanjong Pagar, offering another choice for residents who are happy to travel towards the city fringe for dining.",
        highlight:
          "A destination dining option around Tanjong Pagar rather than a doorstep choice.",
        gallery: [
          "/images/keisuke-tori-king-menu.webp",
          "/images/keisuke-tori-king-black-spicy.webp",
        ],
      },
      {
        number: "10",
        id: "keisuke-hamburg",
        name: "Keisuke Hamburg",
        location: "Tanjong Pagar",
        images: [
          {
            src: "/images/rs-keisuke-hamburg-tanjong-pagar(3).webp",
            alt: "Keisuke Hamburg Tanjong Pagar storefront",
          },
          {
            src: "/images/rs-keisuke-hamburg-tanjong-pagar(2).webp",
            alt: "Keisuke Hamburg dishes",
          },
          {
            src: "/images/rs-keisuke-hamburg-tanjong-pagar(1).webp",
            alt: "Keisuke Hamburg interior setup",
          },
        ],
        description:
          "Keisuke Hamburg is a Japanese hamburger steak restaurant in the Tanjong Pagar area, offering a different style of Japanese dining from the more familiar sushi and ramen choices.",
        highlight:
          "A destination worth considering when you want to make a specific dining trip towards Tanjong Pagar.",
      },
    ],
  },
];

const restaurantAreas = [
  {
    title: "Alexandra & Anchorpoint",
    description:
      "Alexandra Road and Anchorpoint offer quick convenience for Depot Heights residents, featuring Japanese restaurants, Swedish casual dining, and familiar neighbourhood eateries.",
  },
  {
    title: "Tiong Bahru",
    description:
      "Tiong Bahru combines heritage charm with a vibrant culinary scene, featuring Italian dining, bakeries, cafes, and traditional local food options.",
  },
  {
    title: "Southern Ridges & Pasir Panjang",
    description:
      "The green corridor stretching from Mount Faber through HortPark and Pasir Panjang provides scenic garden dining and unique specialty eateries.",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  image={heroImage}
>
  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="hero-content">
        <p class="eyebrow">
          RESTAURANTS & DINING NEAR DEPOT HEIGHTS
        </p>

        <h1>
          Good food,
          <span>within reach.</span>
        </h1>

        <p class="hero-text">
          Explore recommended restaurants around Alexandra, Bukit Merah,
          Tiong Bahru, Pasir Panjang, Telok Blangah Hill and Tanjong Pagar.
          From convenient neighbourhood dining to destination restaurants,
          there are plenty of choices within reach of Depot Heights.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="#restaurant-guide">
            Explore restaurants
          </a>

          <a class="button secondary" href="/cafes">
            Explore cafés
          </a>
        </div>
      </div>

      <div class="hero-card">
        <img
          src={heroImage}
          alt="Depot Heights residential estate"
          width="600"
          height="400"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <div class="hero-card-overlay">
          <p>DEPOT HEIGHTS</p>

          <div class="hero-card-line"></div>

          <strong>
            Restaurants & dining.<br />
            Neighbourhood guide.
          </strong>
        </div>
      </div>
    </section>

    <!-- INTRO -->
    <section class="intro">
      <p class="eyebrow">
        RESTAURANTS & DINING
      </p>

      <h2>
        A wider dining scene is just a short journey from Depot Heights.
      </h2>

      <p>
        Whether you are looking for family dining, Japanese cuisine,
        Italian pizza, Taiwanese food, Swedish-style casual dining or a
        heritage dining experience, these restaurants offer a range of
        choices around the wider Alexandra and Bukit Merah area.
      </p>
    </section>

    <!-- RESTAURANT GUIDE BY ESTATE -->
    <div class="section-grid" id="restaurant-guide">
      {
        restaurantEstates.map((group) => (
          <div class="estate-group">
            <div class="estate-heading-wrapper">
              <span class="estate-badge">NEIGHBOURHOOD ZONE</span>
              <h2>{group.estate}</h2>
            </div>

            <div class="estate-cafes-container">
              {group.restaurants.map((restaurant) => (
                <article class="section-card" id={restaurant.id}>
                  <div class="section-number">
                    {restaurant.number}
                  </div>

                  <div>
                    <p class="eyebrow">
                      {restaurant.location}
                    </p>

                    <h2>
                      {restaurant.name}
                    </h2>

                    <p class="section-description">
                      {restaurant.description}
                    </p>

                    {
                      restaurant.images ? (
                        <div class="cafe-photo-grid four-photos">
                          {restaurant.images.map((photo) => (
                            <figure class="cafe-photo-card">
                              <img
                                src={photo.src}
                                alt={photo.alt}
                                width="400"
                                height="300"
                                loading="lazy"
                                decoding="async"
                              />
                            </figure>
                          ))}
                        </div>
                      ) : restaurant.gallery ? (
                        <div class="cafe-photo-grid two-photos">
                          <figure class="cafe-photo-card">
                            <img
                              src={restaurant.image}
                              alt={restaurant.alt}
                              width="400"
                              height="300"
                              loading="lazy"
                              decoding="async"
                            />
                          </figure>
                          <figure class="cafe-photo-card">
                            <img
                              src={restaurant.gallery[0]}
                              alt={`${restaurant.name} food and dining`}
                              width="400"
                              height="300"
                              loading="lazy"
                              decoding="async"
                            />
                          </figure>
                        </div>
                      ) : (
                        <div class="main-cafe-image">
                          <img
                            src={restaurant.image}
                            alt={restaurant.alt}
                            width="800"
                            height="480"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      )
                    }

                    <div class="highlight-box">
                      <p class="highlight-eyebrow">
                        GOOD TO KNOW
                      </p>

                      <p>
                        {restaurant.highlight}
                      </p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- AREAS TO EXPLORE -->
    <section class="area-section">
      <div class="area-heading">
        <p class="eyebrow">
          POPULAR DINING AREAS
        </p>

        <h2>
          Popular dining areas near Depot Heights.
        </h2>

        <p>
          These neighbourhoods and districts offer a wider range of
          restaurants and dining experiences within the wider area around
          Depot Heights.
        </p>
      </div>

      <div class="area-grid">
        {
          restaurantAreas.map((area) => (
            <article class="area-card">
              <h3>
                {area.title}
              </h3>

              <p>
                {area.description}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- FEATURED -->
    <section class="featured">
      <div>
        <p class="eyebrow">
          RESTAURANTS GUIDE
        </p>

        <h2>
          Good food, within reach of Depot Heights.
        </h2>
      </div>

      <p>
        From casual neighbourhood spots to special destination dining,
        explore the variety of culinary options available across Alexandra,
        Bukit Merah, Tiong Bahru, and the Southern Ridges.
      </p>
    </section>

    <!-- RELATED -->
    <section class="related-section">
      <div class="related-heading">
        <p class="eyebrow">
          MORE FOOD & DINING
        </p>

        <h2>
          Continue exploring the neighbourhood.
        </h2>
      </div>

      <div class="related-grid">
        <article class="related-card">
          <h3>
            Cafés
          </h3>

          <p>
            Explore coffee spots, bakeries and brunch destinations around
            Mount Faber, Tiong Bahru, Alexandra and Depot Heights.
          </p>

          <a class="text-link" href="/cafes">
            Explore Cafés →
          </a>
        </article>

        <article class="related-card">
          <h3>
            Local Food
          </h3>

          <p>
            Discover hawker centres, local dishes and traditional food
            destinations around Bukit Merah and Alexandra.
          </p>

          <a class="text-link" href="/local-food">
            Explore Local Food →
          </a>
        </article>

        <article class="related-card">
          <h3>
            Lifestyle & Nature
          </h3>

          <p>
            Explore parks, heritage sites, arts, shopping and leisure
            destinations around Depot Heights and the surrounding
            neighbourhoods.
          </p>

          <a class="text-link" href="/living-around-depot-heights">
            Explore Lifestyle & Nature →
          </a>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    color: #1d2924;
    background: #f7f5ef;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .hero {
    display: grid;
    grid-template-columns:
      minmax(0, 1.5fr)
      minmax(280px, 0.7fr);
    min-height: 78vh;
    padding: 8rem 8vw 6rem;
    gap: 5rem;
    align-items: center;
    background:
      radial-gradient(
        circle at 80% 30%,
        rgba(94, 145, 112, 0.22),
        transparent 35%
      ),
      linear-gradient(
        135deg,
        #eef3e9 0%,
        #f7f5ef 60%
      );
  }

  .hero-content {
    max-width: 850px;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: #3d805f;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size:
      clamp(45px, 8vw, 80px);
    line-height: 0.94;
    letter-spacing: -0.07em;
  }

  h1 span {
    display: block;
    color: #3d805f;
  }

  .hero-text {
    max-width: 700px;
    margin: 1.8rem 0 0;
    color: #53615b;
    font-size: 17px;
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    padding: 0.9rem 1.25rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 750;
  }

  .primary {
    color: white;
    background: #27664d;
  }

  .secondary {
    color: #27664d;
    border: 1px solid #9eb3a5;
  }

  .hero-card {
    position: relative;
    min-height: 360px;
    overflow: hidden;
    border-radius: 2rem;
    color: white;
    background: #315f4a;
    box-shadow:
      0 25px 70px
      rgba(39, 102, 77, 0.18);
  }

  .hero-card img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
  }

  .hero-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(31, 72, 55, 0.05),
        rgba(31, 72, 55, 0.9)
      );
  }

  .hero-card-overlay {
    position: absolute;
    z-index: 2;
    right: 2rem;
    bottom: 2rem;
    left: 2rem;
  }

  .hero-card-overlay p {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .hero-card-line {
    width: 50px;
    height: 2px;
    margin: 1rem 0;
    background: white;
  }

  .hero-card strong {
    display: block;
    font-size:
      clamp(1.8rem, 3vw, 3rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .intro {
    max-width: 850px;
    margin: 0 auto;
    padding: 8rem 8vw 4rem;
    text-align: center;
  }

  .intro h2,
  .featured h2,
  .related-heading h2,
  .area-heading h2 {
    margin: 0;
    font-size:
      clamp(38px, 5vw, 65px);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .intro > p:last-child {
    margin: 1.5rem auto 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.7;
  }

  .section-grid {
    padding: 2rem 8vw 8rem;
    max-width: 1300px;
    margin: 0 auto;
  }

  .estate-group {
    margin-bottom: 5rem;
  }

  .estate-group:last-child {
    margin-bottom: 0;
  }

  .estate-heading-wrapper {
    max-width: 1100px;
    margin: 0 auto 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 2px solid #27664d;
  }

  .estate-badge {
    display: inline-block;
    color: #27664d;
    background: rgba(39, 102, 77, 0.1);
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
  }

  .estate-heading-wrapper h2 {
    margin: 0;
    font-size: clamp(28px, 3.5vw, 48px);
    letter-spacing: -0.04em;
    color: #1d2924;
  }

  .section-card {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 0;
    border-top:
      1px solid
      rgba(29, 41, 36, 0.15);
  }

  .estate-cafes-container .section-card:first-of-type {
    border-top: none;
    padding-top: 1rem;
  }

  .section-number {
    color: #70a281;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .section-card h2 {
    margin: 0;
    font-size:
      clamp(38px, 4vw, 65px);
    letter-spacing: -0.05em;
  }

  .section-description {
    max-width: 700px;
    margin: 1.2rem 0 2rem;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .main-cafe-image {
    margin: 2rem 0;
  }

  .main-cafe-image img {
    display: block;
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    border-radius: 2rem;
    box-shadow:
      0 20px 50px
      rgba(39, 102, 77, 0.12);
  }

  .cafe-photo-grid {
    display: grid;
    gap: 1rem;
    margin: 2rem 0;
  }

  .cafe-photo-grid.two-photos {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .cafe-photo-grid.four-photos {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .cafe-photo-card {
    margin: 0;
    overflow: hidden;
    border-radius: 1.5rem;
    border: 1px solid #cbd5cd;
    background: #eef1ec;
  }

  .cafe-photo-card img {
    display: block;
    width: 100%;
    height: 300px;
    object-fit: cover;
    transition:
      transform 0.3s ease;
  }

  .cafe-photo-card:hover img {
    transform: scale(1.03);
  }

  .highlight-box {
    padding: 1.5rem 1.7rem;
    border-left:
      4px solid
      #3d805f;
    border-radius:
      0 1.2rem 1.2rem 0;
    background:
      rgba(61, 128, 95, 0.08);
  }

  .highlight-box p {
    margin: 0;
    color: #53615b;
    font-size: 16px;
    line-height: 1.7;
  }

  .highlight-box .highlight-eyebrow {
    margin-bottom: 0.5rem;
    color: #27664d;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .area-section {
    padding: 7rem 8vw;
    background: #e9eee7;
  }

  .area-heading {
    max-width: 850px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .area-heading > p:last-child {
    max-width: 700px;
    margin: 1.5rem auto 0;
    color: #65736c;
    font-size: 17px;
    line-height: 1.8;
  }

  .area-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .area-card {
    padding: 2rem;
    border:
      1px solid
      #cbd5cd;
    border-radius: 1.5rem;
    background:
      rgba(255, 255, 255, 0.35);
  }

  .area-card h3 {
    margin: 0;
    color: #27664d;
    font-size:
      clamp(23px, 2vw, 28px);
    letter-spacing: -0.03em;
  }

  .area-card p {
    margin: 1rem 0 0;
    color: #65736c;
