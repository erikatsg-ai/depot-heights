---
// You can replace this with a WebP background image of Depot Heights
// import heroBackground from '../assets/depot-heights-hero.webp';
---

<section class="hero-container" aria-label="Welcome to Depot Heights">
  <!-- Use a WebP image or a CSS gradient for the background to save GPU load -->
  <div class="hero-bg" aria-hidden="true"></div>
  
  <div class="hero-content">
    <header class="hero-header">
      <span class="hero-eyebrow">Welcome Home</span>
      <h1>
        Discover <span class="text-gradient">Depot Heights</span>
      </h1>
      <p>
        Experience tranquil living in Bukit Merah, surrounded by the lush greenery of the Southern Ridges, Telok Blangah Hill, and seamless park connectors.
      </p>
    </header>

    <nav class="hero-links" aria-label="Quick links">
      <a class="button button-primary" href="/parks-pcn">
        Explore Nearby Parks
      </a>
      <a class="button button-outline" href="/amenities">
        View Amenities
      </a>
    </nav>
  </div>

  <aside class="hero-news box">
    <div class="news-icon" aria-hidden="true">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path>
      </svg>
    </div>
    <div class="news-text">
      <h2>New Rail Corridor Access</h2>
      <p>Seamlessly walk or cycle to the newly upgraded Rail Corridor directly from Depot Heights.</p>
    </div>
  </aside>
</section>

<style>
  /* =========================================
     HERO LAYOUT & PERFORMANCE FIXES
  ========================================== */
  .hero-container {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 80vh;
    padding: 2rem 1.5rem;
    overflow: hidden;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  /* 
    PERFORMANCE WIN: 
    Instead of a massive image with blur(100px) which lags mobile devices, 
    we use a highly optimized CSS radial gradient that renders instantly. 
  */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: 
      radial-gradient(circle at 15% 50%, rgba(43, 110, 82, 0.08), transparent 50%),
      radial-gradient(circle at 85% 30%, rgba(19, 50, 39, 0.05), transparent 50%);
    background-color: #f7fcf9;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    width: 100%;
    text-align: center;
  }

  /* =========================================
     SEO-FRIENDLY TYPOGRAPHY
  ========================================== */
  .hero-header {
    margin-bottom: 2.5rem;
  }

  .hero-eyebrow {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #2b6e52;
    margin-bottom: 1rem;
  }

  .hero-header h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    font-weight: 800;
    color: #133227;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.03em;
  }

  /* Modern gradient text effect without JS */
  .text-gradient {
    background: linear-gradient(83.21deg, #2b6e52 0%, #449a75 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-header p {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: #4b5a52;
    max-width: 600px;
    margin: 0 auto;
  }

  /* =========================================
     ACCESSIBLE, FAST BUTTONS
  ========================================== */
  .hero-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 99px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .button-primary {
    background: #133227;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(19, 50, 39, 0.2);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    background: #1e4d3c;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(19, 50, 39, 0.3);
  }

  .button-outline {
    background: transparent;
    color: #133227;
    border: 2px solid #133227;
  }

  .button-outline:hover,
  .button-outline:focus-visible {
    background: rgba(19, 50, 39, 0.05);
    transform: translateY(-2px);
  }

  .button:focus-visible {
    outline: 3px solid #6d9a7c;
    outline-offset: 3px;
  }

  /* =========================================
     INFO BOX / NEWS WIDGET
  ========================================== */
  .box {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(19, 50, 39, 0.1);
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    backdrop-filter: blur(12px);
  }

  .hero-news {
    position: absolute;
    bottom: 2rem;
    right: 2rem;
    max-width: 320px;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    text-decoration: none;
    z-index: 10;
  }

  .news-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: #e6f0eb;
    color: #2b6e52;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .news-text h2 {
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
    font-weight: 700;
    color: #133227;
  }

  .news-text p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #5d6b64;
  }

  /* =========================================
     RESPONSIVE
  ========================================== */
  @media screen and (max-height: 700px) {
    .hero-news {
      display: none; /* Hide news widget on very short screens */
    }
  }

  @media screen and (max-width: 768px) {
    .hero-container {
      min-height: 70vh;
      padding-top: 15vh;
      justify-content: flex-start;
    }

    .hero-links {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
      margin: 0 auto;
    }

    .button {
      width: 100%;
    }

    .hero-news {
      position: relative;
      bottom: auto;
      right: auto;
      margin-top: 3rem;
      max-width: 100%;
    }
  }
</style>